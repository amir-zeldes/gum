                  ( Satellite (span 91 101) (rel2par topic-question)
                    ( Nucleus (span 91 96) (rel2par joint-list)
                      ( Nucleus (leaf 91) (rel2par span) (text _!How is that not commercial ?_!) )
                      ( Satellite (span 92 96) (rel2par context-background)
                        ( Satellite (span 92 93) (rel2par attribution-positive)
                          ( Satellite (leaf 92) (rel2par organization-phatic) (text _!I mean ,_!) )
