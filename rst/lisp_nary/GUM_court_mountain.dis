              ( Nucleus (leaf 27) (rel2par joint-list) (text _!Ramona Stewart is here with us today ._!) )
              ( Nucleus (span 28 30) (rel2par joint-list)
                ( Nucleus (span 28 29) (rel2par span)
                  ( Nucleus (leaf 28) (rel2par span) (text _!Also here are amicus parties_!) )
                  ( Satellite (leaf 29) (rel2par elaboration-attribute) (text _!who have filed briefs in support of the Palmers ,_!) )
                )
                ( Satellite (leaf 30) (rel2par elaboration-additional) (text _!including the Landlords ' Association and the Bridger Canyon Property Rights Coalition ._!) )
