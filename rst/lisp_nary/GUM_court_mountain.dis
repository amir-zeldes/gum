        ( Nucleus (span 31 38) (rel2par span)
          ( Satellite (span 31 34) (rel2par organization-phatic)
            ( Nucleus (leaf 31) (rel2par span) (text _!Thank you_!) )
            ( Satellite (span 32 34) (rel2par causal-cause)
              ( Nucleus (leaf 32) (rel2par span) (text _!for inviting us here_!) )
              ( Satellite (span 33 34) (rel2par purpose-goal)
                ( Nucleus (leaf 33) (rel2par span) (text _!to address these important issues for our state ,_!) )
                ( Satellite (leaf 34) (rel2par elaboration-attribute) (text _!which involve important questions of contract interpretation , the scope of property rights , and contract construction ._!) )
              )
            )
          )
          ( Nucleus (span 35 38) (rel2par span)
            ( Nucleus (leaf 35) (rel2par joint-list) (text _!Not only are these questions important for the Palmers and the plaintiffs ,_!) )
            ( Nucleus (span 36 38) (rel2par joint-list)
              ( Nucleus (leaf 36) (rel2par span) (text _!they are important for Montana homeowners and tenants_!) )
              ( Satellite (span 37 38) (rel2par explanation-justify)
                ( Nucleus (leaf 37) (rel2par span) (text _!because residential homes in our state , most of them have some form of residential covenants_!) )
                ( Satellite (leaf 38) (rel2par elaboration-attribute) (text _!that apply to them ._!) )
              )
            )
          )
        )
      )
      ( Nucleus (span 39 168) (rel2par span)
        ( Nucleus (span 39 54) (rel2par span)
          ( Satellite (leaf 39) (rel2par organization-preparation) (text _!I 'd like to emphasize three main points in my argument today ._!) )
          ( Nucleus (span 40 54) (rel2par span)
            ( Nucleus (span 40 45) (rel2par joint-list)
              ( Nucleus (span 40 43) (rel2par span)
                ( Satellite (span 40 41) (rel2par organization-preparation)
                  ( Nucleus (leaf 40) (rel2par span) (text _!First , there are two undisputed facts in this case_!) )
                  ( Satellite (leaf 41) (rel2par elaboration-attribute) (text _!that resolve the case in appellants ' favor ._!) )
                )
                ( Nucleus (span 42 43) (rel2par span)
                  ( Nucleus (leaf 42) (rel2par joint-list) (text _!First , the covenants allow rentals ,_!) )
                  ( Nucleus (leaf 43) (rel2par joint-list) (text _!and second , the covenants have no language about duration ._!) )
                )
              )
              ( Satellite (span 44 45) (rel2par evaluation-comment)
                ( Satellite (leaf 44) (rel2par attribution-positive) (text _!We contend_!) )
                ( Nucleus (leaf 45) (rel2par span) (text _!that this makes the covenants unambiguous ._!) )
              )
            )
            ( Nucleus (span 46 48) (rel2par joint-list)
              ( Nucleus (leaf 46) (rel2par span) (text _!Second , our theory of the case is consistent with precedent ,_!) )
              ( Satellite (span 47 48) (rel2par elaboration-additional)
                ( Nucleus (leaf 47) (rel2par span) (text _!including Craig Tracts and its progeny like Meyers v Kleinhans ,_!) )
                ( Satellite (leaf 48) (rel2par adversative-concession) (text _!whether or not the court finds the covenants ambiguous ._!) )
              )
            )
            ( Nucleus (span 49 54) (rel2par joint-list)
              ( Nucleus (leaf 49) (rel2par span) (text _!And third , this case is critical to upholding Montana 's historic protection of fundamental property rights ._!) )
              ( Satellite (span 50 54) (rel2par explanation-justify)
                ( Nucleus (span 50 51) (rel2par joint-list)
                  ( Nucleus (leaf 50) (rel2par joint-list) (text _!Not only is rental use one of the sticks in the bundle of property rights ,_!) )
                  ( Nucleus (leaf 51) (rel2par joint-list) (text _!but short term rental use has been around since the founding of our country ._!) )
                )
                ( Nucleus (span 52 54) (rel2par joint-list)
                  ( Nucleus (leaf 52) (rel2par same-unit) (text _!And_!) )
                  ( Nucleus (span 53 54) (rel2par same-unit)
                    ( Satellite (leaf 53) (rel2par contingency-condition) (text _!if the district court 's decision is not reversed ,_!) )
                    ( Nucleus (leaf 54) (rel2par span) (text _!this case could have wide sweeping and destructive impacts for thousands of Montana homeowners in the rental context and otherwise ._!) )
                  )
                )
              )
            )
          )
        )
        ( Satellite (span 55 168) (rel2par elaboration-additional)
          ( Satellite (leaf 55) (rel2par organization-preparation) (text _!Upon the first point , there are two critical and disputed facts ._!) )
          ( Nucleus (span 56 168) (rel2par span)
            ( Nucleus (span 56 59) (rel2par span)
              ( Nucleus (span 56 57) (rel2par adversative-contrast)
                ( Satellite (leaf 56) (rel2par attribution-positive) (text _!First , we think_!) )
                ( Nucleus (leaf 57) (rel2par span) (text _!these facts make the covenants unambiguous ._!) )
              )
              ( Nucleus (span 58 59) (rel2par adversative-contrast)
                ( Nucleus (leaf 58) (rel2par span) (text _!But at a minimum , they create an ambiguity_!) )
                ( Satellite (leaf 59) (rel2par elaboration-attribute) (text _!that must be resolved in appellant 's favor ._!) )
              )
            )
            ( Satellite (span 60 168) (rel2par explanation-justify)
              ( Nucleus (span 60 65) (rel2par span)
                ( Nucleus (leaf 60) (rel2par span) (text _!Unlike the court 's recent decisions in Craig Tracts or Brown -- Craig Tracts v Brown Drake or Meyers v Kleinhans , in this case , the restrictive covenants at issue permit rentals ._!) )
                ( Satellite (span 61 65) (rel2par explanation-evidence)
                  ( Nucleus (span 61 64) (rel2par joint-list)
                    ( Nucleus (span 61 62) (rel2par span)
                      ( Nucleus (leaf 61) (rel2par span) (text _!The terms expressly contemplate rentals in the section A6 ,_!) )
                      ( Satellite (leaf 62) (rel2par elaboration-attribute) (text _!which is about advertising ,_!) )
                    )
                    ( Satellite (span 63 64) (rel2par elaboration-additional)
                      ( Nucleus (leaf 63) (rel2par span) (text _!and it 's talking about signs ._!) )
                      ( Satellite (leaf 64) (rel2par elaboration-additional) (text _!It allows signs , advertising billboards , and advertising structures for sale or rent ._!) )
                    )
                  )
                  ( Nucleus (leaf 65) (rel2par joint-list) (text _!And the plaintiffs themselves use their property for long term rental ._!) )
                )
              )
              ( Satellite (span 66 168) (rel2par elaboration-additional)
                ( Nucleus (span 66 90) (rel2par span)
                  ( Satellite (span 66 73) (rel2par topic-question)
                    ( Nucleus (span 66 72) (rel2par span)
                      ( Satellite (span 66 67) (rel2par organization-preparation)
                        ( Satellite (leaf 66) (rel2par topic-question) (text _!Could I interrupt you ?_!) )
                        ( Nucleus (leaf 67) (rel2par span) (text _!Of course ._!) )
                      )
