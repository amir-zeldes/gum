	<body>
		<segment id="1" parent="141" relname="restatement-repetition">When did they first postulate black holes ?</segment>
		<segment id="2" parent="141" relname="restatement-repetition">When did they first postulate black holes ?</segment>
		<segment id="3" parent="167" relname="organization-preparation">Oh , we got a year .</segment>
		<segment id="4" parent="134" relname="span">My actual original guess would have been Einstein .</segment>
		<segment id="5" parent="6" relname="organization-phatic">Because was n't it --</segment>
		<segment id="6" parent="145" relname="span">is n't it relativistic that something ?</segment>
		<segment id="7" parent="8" relname="organization-phatic">I 'm just going to say --</segment>
		<segment id="8" parent="146" relname="span">I 'm just going to say the 40s .</segment>
		<segment id="9" parent="10" relname="adversative-concession">Well , so 1915 was when Einstein first started talking about it .</segment>
		<segment id="10" parent="144" relname="span">But the first positing of the existence of black holes actually dates back to 1783 .</segment>
		<segment id="11" parent="158" relname="restatement-repetition">What ?</segment>
		<segment id="12" parent="158" relname="restatement-repetition">That 's impossible .</segment>
		<segment id="13" parent="165" relname="restatement-partial">1783 .</segment>
		<segment id="14" parent="169" relname="span">The idea of a body so massive</segment>
		<segment id="15" parent="14" relname="causal-result">that even light could not escape</segment>
		<segment id="16" parent="132" relname="span">was first put forward by geologist John Mitchell in a letter</segment>
		<segment id="17" parent="16" relname="elaboration-attribute">written to Henry Cavendish in 1783 to the Royal Society .</segment>
		<segment id="18" parent="174" relname="attribution-positive">And I quote ,</segment>
		<segment id="19" parent="159" relname="contingency-condition">“ if the semi-diameter of a sphere of the same density as the sun were to exceed or to exceed that of the sun , and the proportion of 500 to 1 ,</segment>
		<segment id="20" parent="133" relname="span">a body</segment>
		<segment id="21" parent="20" relname="elaboration-attribute">falling from an infinite height towards it</segment>
		<segment id="22" parent="171" relname="same-unit">would have acquired surface greater velocity than that of light ,</segment>
		<segment id="23" parent="172" relname="same-unit">and consequently ,</segment>
		<segment id="24" parent="173" relname="contingency-condition">supposing light to be attracted by the same force in proportion to its inertia with other bodies ,</segment>
		<segment id="25" parent="160" relname="span">all light</segment>
		<segment id="26" parent="25" relname="elaboration-attribute">emitted from such a body</segment>
		<segment id="27" parent="173" relname="same-unit">would be made to return towards it by its own gravity ” .</segment>
		<segment id="28" parent="178" relname="joint-sequence">So he did the gravity math</segment>
		<segment id="29" parent="176" relname="attribution-positive">and said ,</segment>
		<segment id="30" parent="31" relname="explanation-evidence">according to this ,</segment>
		<segment id="31" parent="176" relname="span">it pulls down stronger than -- than the speed of light .</segment>
		<segment id="32" parent="180" relname="span">And in fact , in 1796 , a mathematician , Pierre - Simon Laplace , promoted the same idea in both the first and second editions of his book Exposition du système du monde .</segment>
		<segment id="33" parent="32" relname="evaluation-comment">Oh , I hate that guy .</segment>
		<segment id="34" parent="180" relname="causal-result">Well , we 'll have to get copies of that .</segment>
		<segment id="35" parent="182" relname="span">And -- but it was removed from later editions .</segment>
		<segment id="36" parent="35" relname="organization-phatic">Oh .</segment>
		<segment id="37" parent="184" relname="span">It only exists in the first and second edition .</segment>
		<segment id="38" parent="39" relname="explanation-justify">Oh , well , that 's going to be hard to find , then .</segment>
		<segment id="39" parent="185" relname="span">Scratch that .</segment>
		<segment id="40" parent="189" relname="span">Uh , so there you go , 1783 .</segment>
		<segment id="41" parent="147" relname="organization-phatic">I was --</segment>
		<segment id="42" parent="147" relname="span">I was pretty surprised myself</segment>
		<segment id="43" parent="42" relname="context-circumstance">when I found that one out .</segment>
		<segment id="44" parent="149" relname="span">The densest , most massive singular objects in the universe</segment>
		<segment id="45" parent="44" relname="elaboration-attribute">formed in one of three main processes .</segment>
		<segment id="46" parent="190" relname="span">Name those processes .</segment>
		<segment id="47" parent="46" relname="restatement-partial">Go .</segment>
		<segment id="48" parent="192" relname="restatement-repetition">Collapsing .</segment>
		<segment id="49" parent="192" relname="restatement-repetition">Stars start to collapse .</segment>
		<segment id="50" parent="193" relname="span">Supernova collapsing , number one .</segment>
		<segment id="51" parent="50" relname="organization-phatic">Right .</segment>
		<segment id="52" parent="137" relname="span">When two large stars --</segment>
		<segment id="53" parent="143" relname="restatement-repetition">Neutron stars --</segment>
		<segment id="54" parent="194" relname="span">Neutron stars .</segment>
		<segment id="55" parent="54" relname="organization-phatic">Yeah .</segment>
		<segment id="56" parent="197" relname="context-circumstance">Locked in a binary relationship ,</segment>
		<segment id="57" parent="197" relname="joint-sequence">spiral together</segment>
		<segment id="58" parent="197" relname="joint-sequence">and merge .</segment>
		<segment id="59" parent="198" relname="restatement-repetition">Oh , that was one .</segment>
		<segment id="60" parent="199" relname="span">That 's the other one</segment>
		<segment id="61" parent="60" relname="elaboration-attribute">I was going to go with .</segment>
		<segment id="62" parent="199" relname="organization-phatic">Yeah , yeah .</segment>
		<segment id="63" parent="203" relname="organization-phatic">And then --</segment>
		<segment id="64" parent="202" relname="restatement-repetition">I was --</segment>
		<segment id="65" parent="202" relname="restatement-repetition">I was going to --</segment>
		<segment id="66" parent="203" relname="span">when worlds collide , was what I was going to say .</segment>
		<segment id="67" parent="204" relname="organization-phatic">Right , right .</segment>
		<segment id="68" parent="207" relname="span">And then number three</segment>
		<segment id="69" parent="68" relname="elaboration-attribute">postulated by our own Lego Stephen Hawking ,</segment>
		<segment id="70" parent="208" relname="same-unit">that trillions of black holes were formed in the Big Bang .</segment>
		<segment id="71" parent="208" relname="organization-phatic">Right .</segment>
		<segment id="72" parent="150" relname="span">Not accepted by all scientists .</segment>
		<segment id="73" parent="72" relname="evaluation-comment">Wow .</segment>
		<segment id="74" parent="75" relname="topic-question">So there 's a controversy ?</segment>
		<segment id="75" parent="138" relname="span">Yeah .</segment>
		<segment id="76" parent="212" relname="span">Trillions , so --</segment>
		<segment id="77" parent="76" relname="elaboration-attribute">some of which still exist today .</segment>
		<segment id="78" parent="79" relname="attribution-positive">I think</segment>
		<segment id="79" parent="214" relname="span">there 's a lot of black hole controversy .</segment>
		<segment id="80" parent="215" relname="attribution-positive">I think that</segment>
		<segment id="81" parent="136" relname="context-circumstance">when in reading up on this ,</segment>
		<segment id="82" parent="135" relname="attribution-positive">I think</segment>
		<segment id="83" parent="84" relname="evaluation-comment">that 's what I found to be the most interesting thing ,</segment>
		<segment id="84" parent="135" relname="span">is that pretty much every single theory about black holes seem to come with controversy .</segment>
		<segment id="85" parent="162" relname="span">It 's an enigma</segment>
		<segment id="86" parent="217" relname="span">wrapped in a mystery ,</segment>
		<segment id="87" parent="218" relname="span">wrapped in --</segment>
		<segment id="88" parent="219" relname="joint-disjunction">A riddle .</segment>
		<segment id="89" parent="219" relname="joint-disjunction">Nothingness .</segment>
		<segment id="90" parent="226" relname="span">It 's really the edge of -- of our knowledge .</segment>
		<segment id="91" parent="90" relname="elaboration-additional">Crushed in nothingness .</segment>
		<segment id="92" parent="93" relname="attribution-positive">Would you say</segment>
		<segment id="93" parent="151" relname="span">it 's the event horizon of our knowledge ?</segment>
		<segment id="94" parent="224" relname="span">This is kind of the event horizon .</segment>
		<segment id="95" parent="96" relname="attribution-positive">Well , I think</segment>
		<segment id="96" parent="227" relname="span">that it 's pretty close to --</segment>
		<segment id="97" parent="229" relname="topic-question">What would you say ?</segment>
		<segment id="98" parent="228" relname="span">It 's the accretion disk of our --</segment>
		<segment id="99" parent="98" relname="evaluation-comment">Wow .</segment>
		<segment id="100" parent="228" relname="restatement-partial">Probably accretion disk --</segment>
		<segment id="101" parent="225" relname="evaluation-comment">We are throwing around some black hole terminology .</segment>
		<segment id="102" parent="237" relname="organization-preparation">Why do n't we talk about what those are actually ?</segment>
		<segment id="103" parent="152" relname="restatement-repetition">What 's an event horizon ?</segment>
		<segment id="104" parent="152" relname="restatement-repetition">An event horizon ?</segment>
		<segment id="105" parent="154" relname="organization-phatic">Oh , my notes that --</segment>
		<segment id="106" parent="107" relname="topic-question">You do n't know ?</segment>
		<segment id="107" parent="234" relname="span">No , no , no , no , no , no .</segment>
		<segment id="108" parent="153" relname="organization-phatic">That 's where</segment>
		<segment id="109" parent="153" relname="span">that 's basically where at the point</segment>
		<segment id="110" parent="109" relname="elaboration-attribute">at which you can not escape a black --</segment>
		<segment id="111" parent="240" relname="restatement-repetition">It 's the point of no return .</segment>
		<segment id="112" parent="239" relname="span">The point</segment>
		<segment id="113" parent="114" relname="organization-phatic">at which the pull of gravity would exceed that of --</segment>
		<segment id="114" parent="155" relname="span">would even pull in light .</segment>
		<segment id="115" parent="239" relname="causal-result">So even light , the fastest thing in the universe , would not be able to escape its pull .</segment>
		<segment id="116" parent="117" relname="adversative-concession">Yes ,</segment>
		<segment id="117" parent="242" relname="span">but are n't there three kinds of black holes , Kevin ?</segment>
		<segment id="118" parent="119" relname="attribution-positive">Oh , I think</segment>
		<segment id="119" parent="156" relname="span">there might be --</segment>
		<segment id="120" parent="244" relname="span">You had only two on your list .</segment>
		<segment id="121" parent="120" relname="organization-phatic">I only had --</segment>
		<segment id="122" parent="247" relname="span">I trumped you .</segment>
		<segment id="123" parent="122" relname="organization-phatic">Uh , yeah .</segment>
		<segment id="124" parent="247" relname="context-background">Toren already showed me up once today .</segment>
		<segment id="125" parent="251" relname="span">Uh , because I 'd read up about the the Schwarzschild --</segment>
		<segment id="126" parent="139" relname="topic-question">Schwarzschild ?</segment>
		<segment id="127" parent="140" relname="span">The Schwarzschild black hole ,</segment>
		<segment id="128" parent="127" relname="elaboration-attribute">which is a non-rotating black hole .</segment>
		<segment id="129" parent="140" relname="organization-phatic">That 's right .</segment>
		<segment id="130" parent="131" relname="organization-phatic">And , and I found ,</segment>
		<segment id="131" parent="157" relname="span">I found out about the Kerr black hole .</segment>
