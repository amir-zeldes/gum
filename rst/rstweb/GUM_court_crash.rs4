	<body>
		<segment id="1" parent="136" relname="topic-question">You ready for your opening statement ?</segment>
		<segment id="2" parent="136" relname="span">People are ,</segment>
		<segment id="3" parent="2" relname="organization-phatic">thank you .</segment>
		<segment id="4" parent="258" relname="organization-phatic">Good afternoon ladies and gentlemen .</segment>
		<segment id="5" parent="138" relname="span">Last year on April 20th , a young mother</segment>
		<segment id="6" parent="5" relname="elaboration-attribute">named Kristen Sigler</segment>
		<segment id="7" parent="139" relname="same-unit">threw a birthday party for her three year old son Stetson .</segment>
		<segment id="8" parent="141" relname="span">Like many mothers , Kristen went all out for the party .</segment>
		<segment id="9" parent="8" relname="explanation-evidence">She had a face painting station , a hot dog bar , entertainers , props and backdrops for photos , and even a bounce house outside of the party .</segment>
		<segment id="10" parent="142" relname="span">Kristen has worked for several years at the Swan Boat Club in Berlin Township , Newport , State of Michigan .</segment>
		<segment id="11" parent="10" relname="elaboration-additional">Right on Lake Erie .</segment>
		<segment id="12" parent="143" relname="span">She used the club 's event space</segment>
		<segment id="13" parent="12" relname="purpose-goal">to hold the party .</segment>
		<segment id="14" parent="145" relname="joint-sequence">The party started at noon</segment>
		<segment id="15" parent="145" relname="joint-sequence">and by a little before 3 p.m. the party guests had just finished singing Happy Birthday to the guest of honor .</segment>
		<segment id="16" parent="148" relname="span">By all accounts , it was a very successful party .</segment>
		<segment id="17" parent="147" relname="joint-list">It was well attended ,</segment>
		<segment id="18" parent="147" relname="joint-list">and the kids there were taking advantage of all the attractions .</segment>
		<segment id="19" parent="150" relname="span">However , at the same time , less than 2 football fields away at her home , the defendant was leaving ,</segment>
		<segment id="20" parent="19" relname="mode-manner">pulling out onto Branshaw Road .</segment>
		<segment id="21" parent="150" relname="elaboration-additional">She was also headed to the boat club .</segment>
		<segment id="22" parent="155" relname="span">Both of these events are memorialized on camera .</segment>
		<segment id="23" parent="151" relname="joint-list">The party was captured on the Swan Boat Club 's security cameras ,</segment>
		<segment id="24" parent="152" relname="span">and the defendant on a home camera</segment>
		<segment id="25" parent="24" relname="elaboration-attribute">mounted above her garage building across the street .</segment>
		<segment id="26" parent="157" relname="span">Mariah Dodds , a longtime friend of Kristen 's , and her three children , Jayden , Zane , and Alanah Phillips had just sat down at a table</segment>
		<segment id="27" parent="26" relname="purpose-goal">to enjoy their lunch from the party 's hot dog bar .</segment>
		<segment id="28" parent="253" relname="span">As they were beginning their meal ,</segment>
		<segment id="29" parent="159" relname="joint-sequence">the defendant backed out of her driveway ,</segment>
		<segment id="30" parent="158" relname="span">accelerated her car in an arc out of her driveway ,</segment>
		<segment id="31" parent="30" relname="causal-result">crashing into a small tree</segment>
		<segment id="32" parent="160" relname="span">and then into her neighbor 's full size pickup truck ,</segment>
		<segment id="33" parent="32" relname="causal-result">forcing it through a wooden fence .</segment>
		<segment id="34" parent="162" relname="joint-sequence">The defendant then places her car in drive</segment>
		<segment id="35" parent="162" relname="joint-sequence">and speeds off toward the boat club , just 4 houses down .</segment>
		<segment id="36" parent="163" relname="context-circumstance">As Mariah grabs cake pops at the dessert station for her kids ,</segment>
		<segment id="37" parent="163" relname="joint-sequence">the defendant barrels at full speed down Branshaw Road</segment>
		<segment id="38" parent="163" relname="joint-sequence">and makes a right turn into the club parking lot .</segment>
		<segment id="39" parent="169" relname="joint-list">Ladies and gentlemen , my name is Ken Lorraine .</segment>
		<segment id="40" parent="169" relname="joint-list">I 'm an assistant prosecutor for the County of Monroe .</segment>
		<segment id="41" parent="166" relname="attribution-positive">Along with my fellow assistant prosecutors , Christopher Marriott and Alexis Hatch , we will prove to you over the course of the next several days</segment>
		<segment id="42" parent="165" relname="span">that defendant 's actions in this case make her guilty of the charges of second degree murder for Zane and Alanah Phillips , OWI</segment>
		<segment id="43" parent="42" relname="causal-result">causing death for Zane and Alanah Phillips ,</segment>
		<segment id="44" parent="167" relname="span">and OWI</segment>
		<segment id="45" parent="44" relname="causal-result">causing serious impairment of a body function for Zane and Alanah 's mom Mariah , their brother Jayden , and for Ed Smothers , Leah Stith , and Diane Medina .</segment>
		<segment id="46" parent="171" relname="adversative-antithesis">I do n't particularly like long and winding opening statements .</segment>
		<segment id="47" parent="171" relname="span">I like to give the jury what I would want</segment>
		<segment id="48" parent="47" relname="contingency-condition">if I were a juror :</segment>
		<segment id="49" parent="173" relname="span">a road map , a table of contents to what the prosecution will present to you over the course of the trial .</segment>
		<segment id="50" parent="175" relname="purpose-goal">To simplify things for you folks ,</segment>
		<segment id="51" parent="174" relname="span">basically the way</segment>
		<segment id="52" parent="51" relname="elaboration-attribute">we 're going to present this</segment>
		<segment id="53" parent="175" relname="same-unit">is you 're gon na hear from our witnesses in four groups .</segment>
		<segment id="54" parent="185" relname="span">The first group will be , uh , guests and boat club members at the party .</segment>
		<segment id="55" parent="177" relname="joint-list">They 'll talk about the party ,</segment>
		<segment id="56" parent="177" relname="joint-list">they 'll talk about the crash ,</segment>
		<segment id="57" parent="177" relname="joint-list">and to some degree , they 'll talk about what they saw , uh , of the defendant .</segment>
		<segment id="58" parent="178" relname="adversative-contrast">Some of them will help us show you video of the crash and its aftermath ,</segment>
		<segment id="59" parent="179" relname="span">some of them will simply tell you what they saw and what they remember , or what they do n't remember ,</segment>
		<segment id="60" parent="59" relname="elaboration-additional">and they 'll tell you what they went through .</segment>
		<segment id="61" parent="183" relname="span">You will not hear from all of them .</segment>
		<segment id="62" parent="182" relname="joint-list">By most accounts , there were some 80 people in and out of the party through the course of the day .</segment>
		<segment id="63" parent="181" relname="span">And several others</segment>
		<segment id="64" parent="63" relname="elaboration-attribute">that just wandered over from the boat club proper after the crash .</segment>
		<segment id="65" parent="186" relname="span">The second group</segment>
		<segment id="66" parent="65" relname="elaboration-attribute">you will hear from</segment>
		<segment id="67" parent="187" relname="same-unit">is the first responders .</segment>
		<segment id="68" parent="197" relname="span">The captain of the Frenchtown Fire Department and many members of the Monroe County Sheriff 's office , they arrived on scene shortly after the crash .</segment>
		<segment id="69" parent="188" relname="span">They will give you more information about the crash , its results , and the steps</segment>
		<segment id="70" parent="189" relname="span">they took</segment>
		<segment id="71" parent="70" relname="purpose-goal">to investigate it .</segment>
		<segment id="72" parent="194" relname="span">Again , you wo n't hear from all of them .</segment>
		<segment id="73" parent="190" relname="joint-list">Law enforcement officers from at least 4 agencies were on scene ,</segment>
		<segment id="74" parent="190" relname="joint-list">as were multiple fire departments , ambulance companies , and 2 life flight helicopters .</segment>
		<segment id="75" parent="191" relname="span">You will hear the stories from the witnesses</segment>
		<segment id="76" parent="75" relname="elaboration-attribute">we call</segment>
		<segment id="77" parent="193" relname="span">and see some of the footage from their body worn cameras .</segment>
		<segment id="78" parent="77" relname="elaboration-additional">Through that medium , you will also hear from the defendant .</segment>
		<segment id="79" parent="199" relname="span">Next , We 're gon na call a group of witnesses</segment>
		<segment id="80" parent="200" relname="span">that are necessary under the rules of evidence</segment>
		<segment id="81" parent="201" relname="span">for you to hear about what was in the defendant 's blood</segment>
		<segment id="82" parent="81" relname="context-circumstance">when she crashed her car .</segment>
		<segment id="83" parent="203" relname="mode-manner">As I spoke about a little bit in voir dire ,</segment>
		<segment id="84" parent="202" relname="adversative-concession">the rules of evidence are sometimes strict and not always straightforward ,</segment>
		<segment id="85" parent="202" relname="span">but they are important</segment>
		<segment id="86" parent="85" relname="purpose-goal">to ensure a fair trial both for the defendant and for the victims .</segment>
		<segment id="87" parent="209" relname="span">Finally , you 'll hear from some of the surviving victims , Mariah , Edward , Leah , and Diane .</segment>
		<segment id="88" parent="87" relname="elaboration-additional">We 'll tell you what they can remember from the crash , about their injuries and somewhat about their road to recovery .</segment>
		<segment id="89" parent="90" relname="organization-phatic">Before I want --</segment>
		<segment id="90" parent="210" relname="span">before I conclude ,</segment>
		<segment id="91" parent="208" relname="span">I wan na speak just briefly about the jury instructions</segment>
		<segment id="92" parent="91" relname="elaboration-attribute">that the judge highlighted</segment>
		<segment id="93" parent="94" relname="attribution-positive">and give you a sense of what the people think</segment>
		<segment id="94" parent="211" relname="span">you should be watching for over the course of the next few days .</segment>
		<segment id="95" parent="96" relname="organization-phatic">Uh , we could bring up the --</segment>
		<segment id="96" parent="214" relname="span">you do n't have to be able to entirely read this .</segment>
		<segment id="97" parent="214" relname="explanation-motivation">You 'll get it printed out at the end of the trial .</segment>
		<segment id="98" parent="216" relname="span">But just roughly , as to the 5 counts , counts 4 through 9 , of OWI</segment>
		<segment id="99" parent="98" relname="causal-result">causing serious impairment of a body function ,</segment>
		<segment id="100" parent="217" relname="same-unit">we have to prove</segment>
		<segment id="101" parent="218" relname="joint-list">that the defendant voluntarily operated her vehicle ,</segment>
		<segment id="102" parent="219" relname="span">that she did so in a parking lot or a place</segment>
		<segment id="103" parent="102" relname="elaboration-attribute">accessible to the general public ,</segment>
		<segment id="104" parent="225" relname="same-unit">and that</segment>
		<segment id="105" parent="223" relname="context-circumstance">while she was operating it ,</segment>
		<segment id="106" parent="220" relname="span">she was either legally intoxicated ,</segment>
		<segment id="107" parent="221" relname="span">which is what we all hear about</segment>
		<segment id="108" parent="107" relname="context-circumstance">when we think of drunk driving ,</segment>
		<segment id="109" parent="222" relname="restatement-repetition">that she was a .08 or higher ,</segment>
		<segment id="110" parent="247" relname="span">or that she was under the influence of alcohol .</segment>
		<segment id="111" parent="228" relname="same-unit">In other words , I could think of a ,</segment>
		<segment id="112" parent="226" relname="organization-phatic">you know ,</segment>
		<segment id="113" parent="226" relname="span">a 90 pound , uh , 25 year old woman</segment>
		<segment id="114" parent="113" relname="elaboration-attribute">who I could give one glass of wine to .</segment>
		<segment id="115" parent="116" relname="adversative-concession">She could be at a .04</segment>
		<segment id="116" parent="229" relname="span">but just be drunk out of her mind .</segment>
		<segment id="117" parent="233" relname="adversative-antithesis">So it 's not always just a .08 ,</segment>
		<segment id="118" parent="233" relname="span">that 's the legal limit</segment>
		<segment id="119" parent="231" relname="attribution-positive">and we consider</segment>
		<segment id="120" parent="230" relname="contingency-condition">if you 're over a .08 ,</segment>
		<segment id="121" parent="122" relname="adversative-concession">regardless of how you feel ,</segment>
		<segment id="122" parent="230" relname="span">you 're legally intoxicated .</segment>
		<segment id="123" parent="244" relname="span">But it is possible for you to find intoxication under a .08 .</segment>
		<segment id="124" parent="234" relname="attribution-positive">Or we can prove</segment>
		<segment id="125" parent="234" relname="span">that she was impaired by the consumption of alcohol and the consumption of a -- uh , intoxicating substance</segment>
		<segment id="126" parent="125" relname="elaboration-attribute">called gabapentin .</segment>
		<segment id="127" parent="239" relname="same-unit">And that</segment>
		<segment id="128" parent="236" relname="organization-preparation">in doing this ,</segment>
		<segment id="129" parent="236" relname="span">in driving</segment>
		<segment id="130" parent="129" relname="context-circumstance">after ingesting these substances ,</segment>
		<segment id="131" parent="238" relname="span">she caused a serious injury to one of those five victims .</segment>
		<segment id="132" parent="242" relname="span">Similarly , the two counts</segment>
		<segment id="133" parent="240" relname="span">of operating</segment>
		<segment id="134" parent="133" relname="context-circumstance">while intoxicated</segment>
		<segment id="135" parent="240" relname="causal-result">causing death , the deaths of Zane and Alanah Phillips .</segment>
		<group id="136" type="span" parent="137" relname="span"/>
