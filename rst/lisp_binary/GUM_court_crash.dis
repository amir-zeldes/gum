                ( Nucleus (leaf 49) (rel2par span) (text _!a road map , a table of contents to what the prosecution will present to you over the course of the trial ._!) )
              )
              ( Nucleus (span 50 53) (rel2par span)
                ( Satellite (leaf 50) (rel2par purpose-goal) (text _!To simplify things for you folks ,_!) )
