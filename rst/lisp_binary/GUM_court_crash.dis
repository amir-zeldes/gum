                      ( Nucleus (leaf 15) (rel2par joint-sequence) (text _!and by a little before 3 p.m. the party guests had just finished singing Happy Birthday to the guest of honor ._!) )
                    )
                  )
                )
              )
              ( Satellite (span 16 18) (rel2par evaluation-comment)
                ( Nucleus (leaf 16) (rel2par span) (text _!By all accounts , it was a very successful party ._!) )
