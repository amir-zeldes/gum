          ( Satellite (span 39 40) (rel2par context-background)
            ( Nucleus (leaf 39) (rel2par joint-list) (text _!Ladies and gentlemen , my name is Ken Lorraine ._!) )
            ( Nucleus (leaf 40) (rel2par joint-list) (text _!I 'm an assistant prosecutor for the County of Monroe ._!) )
          )
          ( Nucleus (span 41 45) (rel2par span)
            ( Satellite (leaf 41) (rel2par attribution-positive) (text _!Along with my fellow assistant prosecutors , Christopher Marriott and Alexis Hatch , we will prove to you over the course of the next several days_!) )
            ( Nucleus (span 42 45) (rel2par span)
              ( Nucleus (span 42 43) (rel2par same-unit)
                ( Nucleus (leaf 42) (rel2par span) (text _!that defendant 's actions in this case make her guilty of the charges of second degree murder for Zane and Alanah Phillips , OWI_!) )
