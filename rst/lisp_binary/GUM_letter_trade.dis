( Root (span 1 123) 
  ( Satellite (leaf 1) (rel2par organization-heading) (text _!Letter to the Chairman of the House Committee on Ways and Means on United States Trade Policy ._!) )
  ( Nucleus (span 2 123) (rel2par span)
    ( Satellite (leaf 2) (rel2par context-circumstance) (text _!May 11 , 1970_!) )
    ( Nucleus (span 3 123) (rel2par span)
      ( Satellite (leaf 3) (rel2par organization-preparation) (text _!Dear Mr. Chairman :_!) )
      ( Nucleus (span 4 123) (rel2par span)
        ( Nucleus (span 4 54) (rel2par joint-other)
          ( Nucleus (span 4 47) (rel2par span)
            ( Nucleus (span 4 17) (rel2par span)
              ( Satellite (span 4 15) (rel2par explanation-motivation)
                ( Satellite (leaf 4) (rel2par evaluation-comment) (text _!It is gratifying to me that you are today beginning hearings on trade legislation ._!) )
                ( Nucleus (span 5 15) (rel2par span)
                  ( Nucleus (span 5 11) (rel2par joint-list)
                    ( Nucleus (leaf 5) (rel2par span) (text _!The Administration welcomes the chance_!) )
                    ( Satellite (span 6 11) (rel2par purpose-attribute)
                      ( Nucleus (span 6 7) (rel2par span)
                        ( Nucleus (leaf 6) (rel2par span) (text _!to testify on behalf of the trade bill_!) )
                        ( Satellite (leaf 7) (rel2par elaboration-attribute) (text _!which I submitted last November ,_!) )
                      )
                      ( Satellite (span 8 11) (rel2par elaboration-attribute)
                        ( Nucleus (leaf 8) (rel2par span) (text _!passage of which we believe to be necessary_!) )
                        ( Satellite (span 9 11) (rel2par purpose-goal)
                          ( Nucleus (leaf 9) (rel2par span) (text _!to provide a start_!) )
                          ( Satellite (span 10 11) (rel2par mode-manner)
                            ( Nucleus (leaf 10) (rel2par span) (text _!in adjusting U.S. trade policy_!) )
                            ( Satellite (leaf 11) (rel2par purpose-goal) (text _!to meet the problems of the 1970s ._!) )
                          )
                        )
                      )
                    )
                  )
                  ( Nucleus (span 12 15) (rel2par joint-list)
                    ( Nucleus (leaf 12) (rel2par span) (text _!These hearings will also be useful_!) )
                    ( Satellite (span 13 15) (rel2par explanation-justify)
                      ( Nucleus (leaf 13) (rel2par span) (text _!in giving all interested citizens a chance_!) )
                      ( Satellite (span 14 15) (rel2par purpose-attribute)
                        ( Nucleus (leaf 14) (rel2par span) (text _!to explain their views on a subject_!) )
                        ( Satellite (leaf 15) (rel2par elaboration-attribute) (text _!which is of great economic and foreign policy significance for this country ._!) )
                      )
                    )
                  )
                )
              )
              ( Nucleus (span 16 17) (rel2par span)
                ( Nucleus (leaf 16) (rel2par span) (text _!I urge speedy enactment of the proposals_!) )
                ( Satellite (leaf 17) (rel2par elaboration-attribute) (text _!which I have sent to the Congress ._!) )
              )
            )
            ( Satellite (span 18 47) (rel2par explanation-motivation)
              ( Nucleus (span 18 37) (rel2par joint-list)
                ( Satellite (span 18 19) (rel2par evaluation-comment)
                  ( Satellite (leaf 18) (rel2par adversative-concession) (text _!The proposals are modest in scope ,_!) )
                  ( Nucleus (leaf 19) (rel2par span) (text _!but they provide needed flexibility for U.S. trade policy in a number of significant ways ._!) )
                )
                ( Nucleus (span 20 37) (rel2par span)
                  ( Satellite (leaf 20) (rel2par organization-preparation) (text _!They would :_!) )
                  ( Nucleus (span 21 37) (rel2par span)
                    ( Nucleus (span 21 29) (rel2par joint-list)
                      ( Nucleus (span 21 23) (rel2par span)
                        ( Nucleus (leaf 21) (rel2par span) (text _!-- Restore the authority_!) )
                        ( Satellite (span 22 23) (rel2par elaboration-attribute)
                          ( Nucleus (leaf 22) (rel2par span) (text _!needed by the President_!) )
                          ( Satellite (leaf 23) (rel2par purpose-attribute) (text _!to make limited tariff reductions ._!) )
                        )
                      )
                      ( Satellite (span 24 29) (rel2par elaboration-additional)
                        ( Satellite (leaf 24) (rel2par adversative-antithesis) (text _!This authority is not intended for major negotiations ,_!) )
                        ( Nucleus (span 25 29) (rel2par span)
                          ( Nucleus (span 25 28) (rel2par span)
                            ( Nucleus (leaf 25) (rel2par span) (text _!but rather to permit minor adjustments ,_!) )
                            ( Satellite (span 26 28) (rel2par mode-manner)
                              ( Nucleus (leaf 26) (rel2par span) (text _!such as would be required_!) )
                              ( Satellite (span 27 28) (rel2par purpose-goal)
                                ( Nucleus (leaf 27) (rel2par span) (text _!to extend compensation to other countries_!) )
                                ( Satellite (leaf 28) (rel2par elaboration-attribute) (text _!hurt by U.S. escape clause actions_!) )
                              )
                            )
                          )
                          ( Satellite (leaf 29) (rel2par causal-result) (text _!- thereby avoiding retaliation against U.S. exports ._!) )
                        )
                      )
                    )
                    ( Nucleus (span 30 37) (rel2par joint-list)
                      ( Nucleus (span 30 33) (rel2par joint-list)
                        ( Nucleus (span 30 31) (rel2par span)
                          ( Nucleus (leaf 30) (rel2par span) (text _!-- Recognize the very real plight of particular industries , companies and workers_!) )
                          ( Satellite (leaf 31) (rel2par elaboration-attribute) (text _!faced with import competition ,_!) )
                        )
                        ( Satellite (span 32 33) (rel2par mode-means)
                          ( Nucleus (leaf 32) (rel2par span) (text _!by providing for a readier escape clause and adjustment assistance relief_!) )
                          ( Satellite (leaf 33) (rel2par contingency-condition) (text _!where justified ._!) )
                        )
                      )
                      ( Nucleus (span 34 37) (rel2par joint-list)
                        ( Nucleus (span 34 35) (rel2par joint-list)
                          ( Nucleus (leaf 34) (rel2par span) (text _!-- Eliminate the American Selling Price system of customs valuation , a major obstacle_!) )
                          ( Satellite (leaf 35) (rel2par elaboration-attribute) (text _!impeding progress toward the reduction of non-tariff barriers ._!) )
                        )
                        ( Nucleus (span 36 37) (rel2par joint-list)
                          ( Nucleus (leaf 36) (rel2par span) (text _!-- Strengthen the hand of the President in his efforts_!) )
                          ( Satellite (leaf 37) (rel2par purpose-attribute) (text _!to ensure fair treatment for U.S. exports ._!) )
                        )
                      )
                    )
                  )
                )
              )
              ( Nucleus (span 38 47) (rel2par joint-list)
                ( Satellite (span 38 44) (rel2par explanation-evidence)
                  ( Nucleus (span 38 40) (rel2par span)
                    ( Satellite (leaf 38) (rel2par context-circumstance) (text _!Since I submitted this legislation to the Congress in November ,_!) )
                    ( Nucleus (span 39 40) (rel2par span)
                      ( Nucleus (leaf 39) (rel2par span) (text _!there have been a number of developments_!) )
                      ( Satellite (leaf 40) (rel2par elaboration-attribute) (text _!which add to its urgency ._!) )
                    )
                  )
                  ( Satellite (span 41 44) (rel2par explanation-evidence)
                    ( Nucleus (span 41 42) (rel2par same-unit)
                      ( Nucleus (leaf 41) (rel2par span) (text _!I cite only the important decisions_!) )
                      ( Satellite (leaf 42) (rel2par elaboration-attribute) (text _!taken by the European Communities_!) )
                    )
                    ( Nucleus (span 43 44) (rel2par same-unit)
                      ( Nucleus (leaf 43) (rel2par span) (text _!on the future evolution of that great trading area , and the consideration by the Congress of new U.S. farm legislation ,_!) )
                      ( Satellite (leaf 44) (rel2par elaboration-attribute) (text _!which would further increase the importance of our access to foreign markets ._!) )
                    )
                  )
                )
                ( Nucleus (span 45 47) (rel2par span)
                  ( Nucleus (leaf 45) (rel2par span) (text _!At a time of rapid movement in international trade relations and patterns , the U.S. will find itself at a disadvantage_!) )
                  ( Satellite (span 46 47) (rel2par contingency-condition)
                    ( Nucleus (leaf 46) (rel2par span) (text _!unless we have the added flexibility_!) )
                    ( Satellite (leaf 47) (rel2par elaboration-attribute) (text _!which I have requested ._!) )
                  )
                )
              )
            )
          )
          ( Satellite (span 48 54) (rel2par restatement-partial)
            ( Satellite (span 48 51) (rel2par explanation-motivation)
              ( Nucleus (span 48 49) (rel2par span)
                ( Satellite (leaf 48) (rel2par explanation-justify) (text _!Progress toward freer trade should continue ._!) )
                ( Nucleus (leaf 49) (rel2par span) (text _!We must encourage it ._!) )
              )
              ( Satellite (span 50 51) (rel2par adversative-antithesis)
                ( Satellite (leaf 50) (rel2par contingency-condition) (text _!Without the strong support of the United States , the world 's largest trader ,_!) )
                ( Nucleus (leaf 51) (rel2par span) (text _!this progress could falter ._!) )
              )
            )
            ( Nucleus (span 52 54) (rel2par span)
              ( Nucleus (span 52 53) (rel2par same-unit)
                ( Nucleus (leaf 52) (rel2par span) (text _!Passage of the legislation_!) )
                ( Satellite (leaf 53) (rel2par elaboration-attribute) (text _!I have submitted_!) )
              )
              ( Nucleus (leaf 54) (rel2par same-unit) (text _!will keep us headed in the right direction ._!) )
            )
          )
        )
        ( Nucleus (span 55 123) (rel2par joint-other)
          ( Satellite (leaf 55) (rel2par organization-heading) (text _!FOR THE FUTURE_!) )
          ( Nucleus (span 56 123) (rel2par span)
            ( Nucleus (span 56 86) (rel2par joint-other)
              ( Satellite (span 56 62) (rel2par explanation-justify)
                ( Nucleus (span 56 61) (rel2par span)
                  ( Satellite (span 56 60) (rel2par adversative-concession)
                    ( Nucleus (span 56 57) (rel2par same-unit)
                      ( Nucleus (leaf 56) (rel2par span) (text _!The legislation_!) )
                      ( Satellite (leaf 57) (rel2par elaboration-attribute) (text _!proposed by the Administration_!) )
                    )
                    ( Nucleus (span 58 60) (rel2par same-unit)
                      ( Nucleus (leaf 58) (rel2par span) (text _!represents an interim step_!) )
                      ( Satellite (span 59 60) (rel2par purpose-attribute)
                        ( Nucleus (leaf 59) (rel2par span) (text _!toward developing the flexible trade policies_!) )
                        ( Satellite (leaf 60) (rel2par elaboration-attribute) (text _!needed for the world of the 1970s ._!) )
                      )
                    )
                  )
                  ( Nucleus (leaf 61) (rel2par span) (text _!For the long range , it is important to reexamine our entire approach ._!) )
                )
                ( Satellite (leaf 62) (rel2par explanation-justify) (text _!Changes in production , trade and investment patterns , and the rapid progress in communications , transportation and technology impel us toward a basic reassessment of our trade policy ._!) )
              )
              ( Nucleus (span 63 86) (rel2par span)
                ( Nucleus (span 63 76) (rel2par joint-list)
                  ( Satellite (span 63 67) (rel2par context-background)
                    ( Nucleus (span 63 65) (rel2par span)
                      ( Nucleus (span 63 64) (rel2par joint-sequence)
                        ( Nucleus (leaf 63) (rel2par span) (text _!I have recently announced the appointment of the chairman of my Commission on International Trade and Investment Policy ,_!) )
                        ( Satellite (leaf 64) (rel2par elaboration-attribute) (text _!which will assist in this reexamination ,_!) )
                      )
                      ( Nucleus (leaf 65) (rel2par joint-sequence) (text _!and I will shortly announce its full membership ._!) )
                    )
                    ( Satellite (span 66 67) (rel2par elaboration-additional)
                      ( Nucleus (leaf 66) (rel2par joint-list) (text _!The Commission is charged with examining the entire range of our trade and related policies ,_!) )
                      ( Nucleus (leaf 67) (rel2par joint-list) (text _!and of preparing recommendations for the next decade ._!) )
                    )
                  )
                  ( Nucleus (span 68 76) (rel2par span)
                    ( Nucleus (span 68 72) (rel2par span)
                      ( Satellite (span 68 69) (rel2par explanation-motivation)
                        ( Nucleus (leaf 68) (rel2par span) (text _!We need more information_!) )
                        ( Satellite (leaf 69) (rel2par elaboration-attribute) (text _!regarding the competitive position of U.S. industries ._!) )
                      )
                      ( Nucleus (span 70 72) (rel2par span)
                        ( Satellite (leaf 70) (rel2par purpose-goal) (text _!So that we will have an adequate factual base ,_!) )
                        ( Nucleus (span 71 72) (rel2par span)
                          ( Satellite (leaf 71) (rel2par attribution-positive) (text _!I am requesting_!) )
                          ( Nucleus (leaf 72) (rel2par span) (text _!that the Tariff Commission make a broad survey of the competitiveness of particular industries ._!) )
                        )
                      )
                    )
                    ( Satellite (span 73 76) (rel2par evaluation-comment)
                      ( Satellite (leaf 73) (rel2par attribution-positive) (text _!I believe_!) )
                      ( Nucleus (span 74 76) (rel2par span)
                        ( Nucleus (span 74 75) (rel2par same-unit)
                          ( Nucleus (leaf 74) (rel2par span) (text _!that such a broad study ,_!) )
                          ( Satellite (leaf 75) (rel2par elaboration-attribute) (text _!which the Tariff Commission is best suited to conduct ,_!) )
                        )
                        ( Nucleus (leaf 76) (rel2par same-unit) (text _!will be of great assistance to us in our future policies and trade actions and in the work of my Commission on International Trade and Investment Policy ._!) )
                      )
                    )
                  )
                )
                ( Nucleus (span 77 86) (rel2par joint-list)
                  ( Nucleus (span 77 79) (rel2par span)
                    ( Nucleus (leaf 77) (rel2par span) (text _!It is my intention to marshal the forces of the executive branch_!) )
                    ( Satellite (span 78 79) (rel2par purpose-goal)
                      ( Nucleus (leaf 78) (rel2par span) (text _!to expedite efficient adjustment to economic changes_!) )
                      ( Satellite (leaf 79) (rel2par elaboration-attribute) (text _!brought about by increased imports ._!) )
                    )
                  )
                  ( Satellite (span 80 86) (rel2par elaboration-additional)
                    ( Nucleus (span 80 84) (rel2par joint-list)
                      ( Nucleus (span 80 81) (rel2par span)
                        ( Nucleus (leaf 80) (rel2par span) (text _!I intend to activate the Trade Adjustment Assistance Advisory Board_!) )
                        ( Satellite (leaf 81) (rel2par elaboration-attribute) (text _!called for in the Trade Expansion Act of 1962_!) )
                      )
                      ( Satellite (span 82 84) (rel2par purpose-goal)
                        ( Nucleus (leaf 82) (rel2par span) (text _!to lead a broad coordinated executive effort_!) )
                        ( Satellite (span 83 84) (rel2par purpose-attribute)
                          ( Nucleus (leaf 83) (rel2par span) (text _!to make adjustment assistance more effective_!) )
                          ( Satellite (leaf 84) (rel2par mode-manner) (text _!in opening opportunities for workers and firms ._!) )
                        )
                      )
                    )
                    ( Nucleus (span 85 86) (rel2par joint-list)
                      ( Nucleus (leaf 85) (rel2par span) (text _!I also intend to request additional funds for adjustment assistance_!) )
                      ( Satellite (leaf 86) (rel2par context-circumstance) (text _!as they are needed ._!) )
                    )
                  )
                )
              )
            )
            ( Nucleus (span 87 123) (rel2par joint-other)
              ( Nucleus (span 87 116) (rel2par joint-other)
                ( Satellite (span 87 94) (rel2par context-background)
                  ( Satellite (leaf 87) (rel2par evaluation-comment) (text _!Certain aspects of our trading relations have been of particular concern in recent years ._!) )
                  ( Nucleus (span 88 94) (rel2par span)
                    ( Nucleus (leaf 88) (rel2par span) (text _!The decline in our trade surplus , from about $ 7 billion in 1964 to only $ 0.8 billion in 1968 , and $ 1.3 billion 1969 , stems from a variety of causes :_!) )
                    ( Satellite (span 89 94) (rel2par causal-cause)
                      ( Nucleus (span 89 90) (rel2par joint-list)
                        ( Nucleus (leaf 89) (rel2par span) (text _!the inflationary forces_!) )
                        ( Satellite (leaf 90) (rel2par elaboration-attribute) (text _!which have dominated our economy in the late sixties ;_!) )
                      )
                      ( Nucleus (span 91 94) (rel2par joint-list)
                        ( Nucleus (leaf 91) (rel2par joint-list) (text _!the growing economic strength and technological progress of our trading partners ;_!) )
                        ( Nucleus (span 92 94) (rel2par joint-list)
                          ( Nucleus (leaf 92) (rel2par joint-list) (text _!the increase in agricultural self - sufficiency abroad ;_!) )
                          ( Nucleus (span 93 94) (rel2par joint-list)
                            ( Nucleus (leaf 93) (rel2par span) (text _!and the increasing demand of American consumers for goods_!) )
                            ( Satellite (leaf 94) (rel2par elaboration-attribute) (text _!made in other countries ._!) )
                          )
                        )
                      )
                    )
                  )
                )
                ( Nucleus (span 95 116) (rel2par span)
                  ( Nucleus (span 95 103) (rel2par joint-list)
                    ( Satellite (span 95 96) (rel2par context-background)
                      ( Satellite (leaf 95) (rel2par explanation-justify) (text _!As I mentioned in my balance of payments statement of April 1969 ,_!) )
                      ( Nucleus (leaf 96) (rel2par span) (text _!it is appropriate to deal with fundamental problems by the use of fundamental remedies ._!) )
                    )
                    ( Nucleus (span 97 103) (rel2par span)
                      ( Nucleus (leaf 97) (rel2par span) (text _!One of the required fundamental remedies has been the reduction of inflationary pressures ._!) )
                      ( Satellite (span 98 103) (rel2par causal-result)
                        ( Nucleus (span 98 101) (rel2par joint-sequence)
                          ( Nucleus (span 98 100) (rel2par same-unit)
                            ( Nucleus (leaf 98) (rel2par span) (text _!With the steps_!) )
                            ( Satellite (span 99 100) (rel2par elaboration-attribute)
                              ( Nucleus (leaf 99) (rel2par span) (text _!we have taken_!) )
                              ( Satellite (leaf 100) (rel2par purpose-goal) (text _!to gain control of inflation ,_!) )
                            )
                          )
                          ( Nucleus (leaf 101) (rel2par same-unit) (text _!there has been some modest evidence of improvement of our trading position ._!) )
                        )
                        ( Nucleus (span 102 103) (rel2par joint-sequence)
                          ( Satellite (leaf 102) (rel2par context-circumstance) (text _!As our anti-inflationary policies continue ,_!) )
                          ( Nucleus (leaf 103) (rel2par span) (text _!we expect a further improvement ._!) )
                        )
                      )
                    )
                  )
                  ( Nucleus (span 104 116) (rel2par joint-list)
                    ( Nucleus (span 104 105) (rel2par span)
                      ( Nucleus (leaf 104) (rel2par span) (text _!At the same time , it is important to take vigorous steps_!) )
                      ( Satellite (leaf 105) (rel2par purpose-attribute) (text _!to improve our exports ._!) )
                    )
                    ( Satellite (span 106 116) (rel2par explanation-evidence)
                      ( Nucleus (span 106 108) (rel2par span)
                        ( Satellite (leaf 106) (rel2par evaluation-comment) (text _!One of the most disquieting trade developments has come in the field of agricultural trade ._!) )
                        ( Nucleus (span 107 108) (rel2par span)
                          ( Satellite (leaf 107) (rel2par adversative-concession) (text _!Although there has been a general reduction in trade barriers in recent decades ,_!) )
                          ( Nucleus (leaf 108) (rel2par span) (text _!there have been contrary trends in agricultural trade ._!) )
                        )
                      )
                      ( Satellite (span 109 116) (rel2par elaboration-additional)
                        ( Nucleus (span 109 112) (rel2par span)
                          ( Nucleus (span 109 111) (rel2par same-unit)
                            ( Nucleus (leaf 109) (rel2par span) (text _!In particular , high trade barriers in a number of countries ,_!) )
                            ( Satellite (span 110 111) (rel2par elaboration-attribute)
                              ( Nucleus (leaf 110) (rel2par span) (text _!used_!) )
                              ( Satellite (leaf 111) (rel2par purpose-goal) (text _!to protect high domestic prices ,_!) )
                            )
                          )
                          ( Nucleus (leaf 112) (rel2par same-unit) (text _!have created difficulties for our agricultural exports ._!) )
                        )
                        ( Satellite (span 113 116) (rel2par causal-result)
                          ( Nucleus (span 113 114) (rel2par joint-list)
                            ( Nucleus (leaf 113) (rel2par span) (text _!We have protested against these measures_!) )
                            ( Satellite (leaf 114) (rel2par context-circumstance) (text _!as each new barrier has been raised_!) )
                          )
                          ( Nucleus (span 115 116) (rel2par joint-list)
                            ( Nucleus (leaf 115) (rel2par joint-disjunction) (text _!and have on occasion been reluctantly forced to threaten_!) )
                            ( Nucleus (leaf 116) (rel2par joint-disjunction) (text _!or to actually take retaliatory measures ._!) )
                          )
                        )
                      )
                    )
                  )
                )
              )
              ( Nucleus (span 117 123) (rel2par joint-other)
                ( Satellite (span 117 118) (rel2par context-background)
                  ( Satellite (leaf 117) (rel2par context-background) (text _!During the past decade , there has been a major integration of the economies of Western Europe ._!) )
                  ( Nucleus (leaf 118) (rel2par span) (text _!We see ahead the prospect of an enlargement of this community ._!) )
                )
                ( Nucleus (span 119 123) (rel2par span)
                  ( Nucleus (span 119 121) (rel2par span)
                    ( Satellite (span 119 120) (rel2par adversative-concession)
                      ( Nucleus (leaf 119) (rel2par joint-sequence) (text _!We wish our friends in Europe well in their efforts toward economic and political unity_!) )
                      ( Nucleus (leaf 120) (rel2par joint-sequence) (text _!and will watch their steps toward this end with sympathetic interest_!) )
                    )
                    ( Nucleus (leaf 121) (rel2par span) (text _!- remaining alert , however , to the need for respect for our commercial interests ._!) )
                  )
                  ( Satellite (span 122 123) (rel2par adversative-concession)
                    ( Satellite (leaf 122) (rel2par attribution-positive) (text _!We would expect , of course ,_!) )
                    ( Nucleus (leaf 123) (rel2par span) (text _!that in the process of enlargement of the European Community , due regard will be given to the rights and interests of the United States and other third countries ._!) )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
