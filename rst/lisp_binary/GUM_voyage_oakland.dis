( Root (span 1 85) 
  ( Satellite (leaf 1) (rel2par organization-heading) (text _!Understand_!) )
  ( Nucleus (span 2 85) (rel2par span)
    ( Nucleus (span 2 11) (rel2par joint-other)
      ( Satellite (span 2 3) (rel2par context-background)
        ( Nucleus (leaf 2) (rel2par span) (text _!Some of the distinctive skyline of Downtown ,_!) )
        ( Satellite (leaf 3) (rel2par elaboration-attribute) (text _!including the Kaiser Building and the Cathedral of Christ the Light ._!) )
      )
      ( Nucleus (span 4 11) (rel2par span)
        ( Satellite (span 4 6) (rel2par context-background)
          ( Satellite (leaf 4) (rel2par adversative-concession) (text _!Often overshadowed by San Francisco , its larger neighbor lying directly to the west ,_!) )
          ( Nucleus (span 5 6) (rel2par span)
            ( Nucleus (leaf 5) (rel2par span) (text _!Oakland has in recent years began to step out from under the shadows ,_!) )
            ( Satellite (leaf 6) (rel2par mode-manner) (text _!playing upon the beautiful highlights of its own and its rise as the multicultural " hipster ' city of the Bay Area ._!) )
          )
        )
        ( Nucleus (span 7 11) (rel2par span)
          ( Satellite (span 7 10) (rel2par explanation-justify)
            ( Nucleus (span 7 8) (rel2par joint-other)
              ( Nucleus (leaf 7) (rel2par span) (text _!Since the 1960s , Oakland has been a hub of radical culture ,_!) )
              ( Satellite (leaf 8) (rel2par explanation-evidence) (text _!and is the birthplace of both the Black Panther Party and the Hell 's Angels ._!) )
            )
            ( Nucleus (span 9 10) (rel2par joint-other)
              ( Nucleus (leaf 9) (rel2par span) (text _!Oakland 's history in the arts and entertainment arena is notable as well ,_!) )
              ( Satellite (leaf 10) (rel2par explanation-evidence) (text _!as Oakland has nurtured or been a second home to novelists Gertrude Stein , Jack London , Amy Tan , and Maya Angelou ; actors Meryl Streep , Mark Hamill , Bruce Lee , and Tom Hanks ; architect Julia " Butterfly " Hill ; classical conductor Calvin Simmons ; rappers MC Hammer , 2Pac , Messy Marv , and several other notables in the liberal arts and sciences ._!) )
            )
          )
          ( Nucleus (leaf 11) (rel2par span) (text _!Oakland as a city reflects the amazing diversity of its residents and long history ._!) )
        )
      )
    )
    ( Nucleus (span 12 85) (rel2par joint-other)
      ( Nucleus (span 12 20) (rel2par joint-other)
        ( Nucleus (span 12 15) (rel2par span)
          ( Nucleus (leaf 12) (rel2par span) (text _!For many visitors , the first place they are likely to visit is Downtown ,_!) )
          ( Satellite (span 13 15) (rel2par contingency-condition)
            ( Nucleus (leaf 13) (rel2par joint-disjunction) (text _!especially if they are in town on business ,_!) )
            ( Nucleus (span 14 15) (rel2par joint-disjunction)
              ( Satellite (leaf 14) (rel2par attribution-negative) (text _!or simply do not know_!) )
              ( Nucleus (leaf 15) (rel2par span) (text _!where to start ._!) )
            )
          )
        )
        ( Satellite (span 16 20) (rel2par explanation-motivation)
          ( Nucleus (span 16 17) (rel2par joint-list)
            ( Nucleus (leaf 16) (rel2par span) (text _!The center of transportation by BART and by bus is there ,_!) )
            ( Satellite (leaf 17) (rel2par purpose-goal) (text _!if one wants to branch out ._!) )
          )
          ( Nucleus (span 18 20) (rel2par joint-list)
            ( Nucleus (span 18 19) (rel2par span)
              ( Nucleus (leaf 18) (rel2par span) (text _!And it is as simple_!) )
              ( Satellite (leaf 19) (rel2par mode-manner) (text _!as walking in a direction from there , for the first few neighborhoods ,_!) )
            )
            ( Satellite (leaf 20) (rel2par causal-cause) (text _!since Old Oakland is along 10th Street , just west of Broadway ._!) )
          )
        )
      )
      ( Nucleus (span 21 85) (rel2par joint-other)
        ( Nucleus (span 21 25) (rel2par joint-other)
          ( Nucleus (leaf 21) (rel2par span) (text _!Just east of Broadway and continuing north and south is Oakland 's famous Chinatown ,_!) )
          ( Satellite (span 22 25) (rel2par evaluation-comment)
            ( Nucleus (span 22 23) (rel2par span)
              ( Satellite (leaf 22) (rel2par purpose-goal) (text _!and that to get the real essence of " Chinatown , "_!) )
              ( Nucleus (leaf 23) (rel2par span) (text _!Oakland rather than San Francisco is your best bet ._!) )
            )
            ( Satellite (span 24 25) (rel2par explanation-evidence)
              ( Nucleus (leaf 24) (rel2par span) (text _!Many of the buildings and streets of Chinatown reflect the diverse nature of its history , in architecture and in the bilingual signs_!) )
              ( Satellite (leaf 25) (rel2par elaboration-attribute) (text _!seen throughout the neighborhood ._!) )
            )
          )
        )
        ( Nucleus (span 26 85) (rel2par joint-other)
          ( Nucleus (span 26 33) (rel2par joint-other)
            ( Nucleus (leaf 26) (rel2par span) (text _!The curious traveler can venture to take a bus southwards along Broadway , and come to Jack London Square ._!) )
            ( Satellite (span 27 33) (rel2par explanation-motivation)
              ( Nucleus (span 27 30) (rel2par span)
                ( Nucleus (span 27 29) (rel2par same-unit)
                  ( Nucleus (leaf 27) (rel2par span) (text _!The unlikely mixture of warehouses and very expensive restaurants and posh atmosphere alongside some of the landmarks of the city 's waterfront makes the Square an interesting place_!) )
                  ( Satellite (span 28 29) (rel2par purpose-attribute)
                    ( Nucleus (leaf 28) (rel2par joint-list) (text _!to visit_!) )
                    ( Nucleus (leaf 29) (rel2par joint-list) (text _!and explore ,_!) )
                  )
                )
                ( Nucleus (leaf 30) (rel2par same-unit) (text _!even for locals ._!) )
              )
              ( Satellite (span 31 33) (rel2par explanation-evidence)
                ( Nucleus (leaf 31) (rel2par span) (text _!It 's the home of the USS Potomac and the site of the namesake author 's residence ,_!) )
                ( Satellite (span 32 33) (rel2par elaboration-attribute)
                  ( Nucleus (leaf 32) (rel2par joint-list) (text _!still preserved_!) )
                  ( Nucleus (leaf 33) (rel2par joint-list) (text _!and humbly standing not far from a saloon from the same era ._!) )
                )
              )
            )
          )
          ( Nucleus (span 34 85) (rel2par joint-other)
            ( Nucleus (span 34 41) (rel2par joint-other)
              ( Nucleus (span 34 40) (rel2par span)
                ( Nucleus (span 34 38) (rel2par span)
                  ( Nucleus (span 34 37) (rel2par span)
                    ( Nucleus (leaf 34) (rel2par span) (text _!Just west of Downtown and slightly north of the Financial District is Uptown ._!) )
                    ( Satellite (span 35 37) (rel2par elaboration-additional)
                      ( Nucleus (leaf 35) (rel2par span) (text _!In the evening it buzzes with art galleries , theaters and residents and Bay Area visitors_!) )
                      ( Satellite (span 36 37) (rel2par elaboration-attribute)
                        ( Nucleus (leaf 36) (rel2par span) (text _!coming into the area_!) )
                        ( Satellite (leaf 37) (rel2par purpose-goal) (text _!to see concerts ._!) )
                      )
                    )
                  )
                  ( Satellite (leaf 38) (rel2par elaboration-additional) (text _!A popular area on the weekend with a mixed vibe of hipster and hip hop ._!) )
                )
                ( Satellite (span 39 40) (rel2par elaboration-additional)
                  ( Nucleus (leaf 39) (rel2par span) (text _!It 's a burgeoning neighborhood of performing arts_!) )
                  ( Satellite (leaf 40) (rel2par elaboration-attribute) (text _!ranging from nightclubs to music halls , avant - garde performance art , and even an improv theater company ._!) )
                )
              )
              ( Satellite (leaf 41) (rel2par elaboration-additional) (text _!Uptown also has some of the best in the city 's vintage architecture , like the Gothic Revival Cathedral Building and the Art Deco Fox and Paramount Theaters , as well as several restaurants ._!) )
            )
            ( Nucleus (span 42 85) (rel2par joint-other)
              ( Nucleus (span 42 45) (rel2par joint-other)
                ( Nucleus (span 42 43) (rel2par span)
                  ( Nucleus (leaf 42) (rel2par span) (text _!North Oakland is a sweeping term ,_!) )
                  ( Satellite (leaf 43) (rel2par elaboration-attribute) (text _!referring to just about everywhere north of Uptown and Lake Merritt ._!) )
                )
                ( Satellite (span 44 45) (rel2par elaboration-additional)
                  ( Nucleus (leaf 44) (rel2par span) (text _!Many of the neighborhoods are commercial centers and absolute heaven for foodies or those_!) )
                  ( Satellite (leaf 45) (rel2par elaboration-attribute) (text _!who seek quieter surroundings than the hustle and bustle of Downtown and Chinatown ._!) )
                )
              )
              ( Nucleus (span 46 85) (rel2par joint-other)
                ( Nucleus (span 46 51) (rel2par joint-other)
                  ( Nucleus (span 46 48) (rel2par span)
                    ( Nucleus (span 46 47) (rel2par span)
                      ( Nucleus (leaf 46) (rel2par span) (text _!Temescal is a neighborhood_!) )
                      ( Satellite (leaf 47) (rel2par elaboration-attribute) (text _!that lies north - northwest from Downtown ,_!) )
                    )
                    ( Satellite (leaf 48) (rel2par elaboration-attribute) (text _!centered along the reach of Telegraph Avenue , at and near 51st Street ._!) )
                  )
                  ( Satellite (span 49 51) (rel2par elaboration-additional)
                    ( Satellite (leaf 49) (rel2par adversative-concession) (text _!Until the 1960s , a dominantly Italian - American neighborhood ,_!) )
                    ( Nucleus (span 50 51) (rel2par span)
                      ( Nucleus (leaf 50) (rel2par span) (text _!it is now a much more diversified neighborhood , home to many restaurants ,_!) )
                      ( Satellite (leaf 51) (rel2par elaboration-attribute) (text _!including some of the city 's best Korean and Ethiopian establishments ._!) )
                    )
                  )
                )
                ( Nucleus (span 52 85) (rel2par joint-other)
                  ( Nucleus (span 52 55) (rel2par joint-other)
                    ( Nucleus (span 52 54) (rel2par span)
                      ( Nucleus (span 52 53) (rel2par span)
                        ( Nucleus (leaf 52) (rel2par span) (text _!Northeast of Temescal and near the Berkeley border lies Rockridge , a neighborhood_!) )
                        ( Satellite (leaf 53) (rel2par elaboration-attribute) (text _!mixed with family friendly and artistic vibes ._!) )
                      )
                      ( Satellite (leaf 54) (rel2par elaboration-additional) (text _!It has lots of local boutiques and a diverse range of food at all prices and styles ._!) )
                    )
                    ( Satellite (leaf 55) (rel2par evaluation-comment) (text _!Open - air markets , bookstores , and a BART station all its own make Rockridge another of many pleasant stops in North Oakland ._!) )
                  )
                  ( Nucleus (span 56 85) (rel2par joint-other)
                    ( Nucleus (span 56 63) (rel2par joint-other)
                      ( Nucleus (span 56 61) (rel2par span)
                        ( Nucleus (span 56 57) (rel2par same-unit)
                          ( Nucleus (leaf 56) (rel2par span) (text _!South of Rockridge , and southeast of Temescal lies Piedmont Avenue , a street_!) )
                          ( Satellite (leaf 57) (rel2par elaboration-attribute) (text _!extending from Broadway near 34th and Hawthorne_!) )
                        )
                        ( Nucleus (span 58 61) (rel2par same-unit)
                          ( Nucleus (span 58 59) (rel2par same-unit)
                            ( Nucleus (leaf 58) (rel2par span) (text _!and an area with a group of hospitals on a hill_!) )
                            ( Satellite (leaf 59) (rel2par elaboration-additional) (text _!( Pill Hill )_!) )
                          )
                          ( Nucleus (span 60 61) (rel2par same-unit)
                            ( Nucleus (leaf 60) (rel2par span) (text _!up and through a neighborhood_!) )
                            ( Satellite (leaf 61) (rel2par elaboration-attribute) (text _!bordered on both sides by picturesque hills , houses and trees ._!) )
                          )
                        )
                      )
                      ( Satellite (span 62 63) (rel2par elaboration-additional)
                        ( Nucleus (leaf 62) (rel2par joint-list) (text _!Another of North Oakland 's group of foodie spots , home to the city 's single Michelin - rated restaurant and many others ;_!) )
                        ( Nucleus (leaf 63) (rel2par joint-list) (text _!cafes , ice cream , coffee shops and pleasant walks complete the vision of this interesting and quiet neighborhood ._!) )
                      )
                    )
                    ( Nucleus (span 64 85) (rel2par joint-other)
                      ( Nucleus (span 64 73) (rel2par joint-other)
                        ( Nucleus (span 64 65) (rel2par span)
                          ( Nucleus (leaf 64) (rel2par span) (text _!East along I - 580 and not far from Piedmont Avenue are two neighborhoods_!) )
                          ( Satellite (leaf 65) (rel2par elaboration-attribute) (text _!separated by a couple of blocks ._!) )
                        )
                        ( Satellite (span 66 73) (rel2par elaboration-additional)
                          ( Nucleus (span 66 69) (rel2par span)
                            ( Nucleus (leaf 66) (rel2par span) (text _!Grand Lake and Lakeshore both share a friendly , suburban sort of feel ._!) )
                            ( Satellite (span 67 69) (rel2par elaboration-additional)
                              ( Nucleus (span 67 68) (rel2par same-unit)
                                ( Nucleus (leaf 67) (rel2par span) (text _!The Grand Lake Theater stands at the entrance to the neighborhood_!) )
                                ( Satellite (leaf 68) (rel2par elaboration-attribute) (text _!that bears its name ,_!) )
                              )
                              ( Nucleus (leaf 69) (rel2par same-unit) (text _!a matter of a few hundred feet from Lakeshore Avenue –_!) )
                            )
                          )
                          ( Satellite (span 70 73) (rel2par evaluation-comment)
                            ( Nucleus (leaf 70) (rel2par joint-list) (text _!both are diverse neighborhoods_!) )
                            ( Nucleus (span 71 73) (rel2par joint-list)
                              ( Satellite (span 71 72) (rel2par adversative-concession)
                                ( Nucleus (leaf 71) (rel2par span) (text _!no matter what your budget ,_!) )
                                ( Satellite (leaf 72) (rel2par elaboration-additional) (text _!be it burgers or sandwiches or a full romantic evening ,_!) )
                              )
                              ( Nucleus (leaf 73) (rel2par span) (text _!either of these twin - sister neighborhoods will make a pleasant time , by day or night ._!) )
                            )
                          )
                        )
                      )
                      ( Nucleus (span 74 85) (rel2par joint-other)
                        ( Nucleus (span 74 83) (rel2par span)
                          ( Nucleus (span 74 77) (rel2par span)
                            ( Nucleus (span 74 76) (rel2par adversative-contrast)
                              ( Nucleus (leaf 74) (rel2par span) (text _!West Oakland was once a burgeoning working - class neighborhood_!) )
                              ( Satellite (span 75 76) (rel2par elaboration-additional)
                                ( Nucleus (leaf 75) (rel2par span) (text _!with its roots tracing as far back_!) )
                                ( Satellite (leaf 76) (rel2par elaboration-additional) (text _!as the opening decades of the 19th century ._!) )
                              )
                            )
                            ( Nucleus (leaf 77) (rel2par adversative-contrast) (text _!It has seen a period of decline between the 1960s and the more recent past ._!) )
                          )
                          ( Satellite (span 78 83) (rel2par context-background)
                            ( Nucleus (leaf 78) (rel2par span) (text _!Strangely , twice in its history the neighborhood has seen benefits from major earthquakes ._!) )
                            ( Satellite (span 79 83) (rel2par elaboration-additional)
                              ( Nucleus (span 79 80) (rel2par joint-other)
                                ( Nucleus (leaf 79) (rel2par span) (text _!After the 1906 earthquake , many San Franciscans relocated there ,_!) )
                                ( Satellite (leaf 80) (rel2par causal-result) (text _!and the industrial development of the 20s and 30s saw its population in the hundreds of thousands ._!) )
                              )
                              ( Nucleus (span 81 83) (rel2par joint-other)
                                ( Nucleus (leaf 81) (rel2par span) (text _!With Loma Prieta in 1989 , the effective barrier of the Cypress Street Overpass was destroyed ,_!) )
                                ( Satellite (span 82 83) (rel2par causal-result)
                                  ( Nucleus (leaf 82) (rel2par joint-list) (text _!and the decades since have seen the rebuilding and refurbishing of many of the neighborhood 's original Victorian houses ,_!) )
                                  ( Nucleus (leaf 83) (rel2par joint-list) (text _!and there is a burgeoning performing arts community growing near the center of the neighborhood ._!) )
                                )
