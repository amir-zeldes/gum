( Root (span 1 93) 
  ( Nucleus (span 1 20) (rel2par joint-list)
    ( Nucleus (leaf 1) (rel2par span) (text _!1. The Profit Motive Moves Most of the Money to the Top_!) )
    ( Satellite (span 2 20) (rel2par explanation-evidence)
      ( Nucleus (span 2 15) (rel2par adversative-contrast)
        ( Nucleus (span 2 13) (rel2par span)
          ( Nucleus (span 2 10) (rel2par adversative-contrast)
            ( Nucleus (span 2 6) (rel2par span)
              ( Satellite (span 2 5) (rel2par causal-cause)
                ( Satellite (span 2 4) (rel2par explanation-evidence)
                  ( Nucleus (leaf 2) (rel2par adversative-contrast) (text _!The federal Medicare Administrator made $ 170,000 in 2010 ._!) )
                  ( Nucleus (span 3 4) (rel2par adversative-contrast)
                    ( Nucleus (leaf 3) (rel2par joint-list) (text _!The president of MD Anderson Cancer Center in Texas made over ten times as much in 2012 ._!) )
                    ( Nucleus (leaf 4) (rel2par joint-list) (text _!Stephen J. Hemsley , the CEO of United Health Group , made almost 300 times as much in one year , $ 48 million , most of it from company stock ._!) )
                  )
                )
                ( Nucleus (leaf 5) (rel2par span) (text _!In part because of such inequities in compensation ,_!) )
              )
              ( Nucleus (leaf 6) (rel2par span) (text _!our private health care system is the most expensive system in the developed world ._!) )
            )
            ( Satellite (span 7 10) (rel2par explanation-evidence)
              ( Nucleus (leaf 7) (rel2par span) (text _!The price of common surgeries is anywhere from three to ten times higher in the U.S. than in Great Britain , Canada , France , or Germany ._!) )
              ( Satellite (span 8 10) (rel2par explanation-evidence)
                ( Satellite (leaf 8) (rel2par organization-preparation) (text _!Two of the documented examples :_!) )
                ( Nucleus (span 9 10) (rel2par span)
                  ( Nucleus (leaf 9) (rel2par joint-list) (text _!an $ 8,000 special stress test for which Medicare would have paid $ 554 ;_!) )
                  ( Nucleus (leaf 10) (rel2par joint-list) (text _!and a $ 60,000 gall bladder operation , for which a private insurance company was willing to pay $ 2,000 ._!) )
                )
              )
            )
          )
          ( Nucleus (span 11 13) (rel2par adversative-contrast)
            ( Nucleus (span 11 12) (rel2par same-unit)
              ( Nucleus (leaf 11) (rel2par span) (text _!Medicare , on the other hand ,_!) )
              ( Satellite (leaf 12) (rel2par elaboration-attribute) (text _!which is largely without the profit motive and the competing sources of billing ,_!) )
            )
            ( Nucleus (leaf 13) (rel2par same-unit) (text _!is efficiently run , for all eligible Americans ._!) )
          )
        )
        ( Satellite (span 14 15) (rel2par explanation-evidence)
          ( Satellite (leaf 14) (rel2par attribution-positive) (text _!According to the Council for Affordable Health Insurance and other sources ,_!) )
          ( Nucleus (leaf 15) (rel2par span) (text _!medical administrative costs are much higher for private insurance than for Medicare ._!) )
        )
      )
      ( Nucleus (span 16 20) (rel2par adversative-contrast)
        ( Nucleus (span 16 18) (rel2par span)
          ( Nucleus (leaf 16) (rel2par span) (text _!But the privatizers keep encroaching on the public sector ._!) )
          ( Satellite (span 17 18) (rel2par explanation-evidence)
            ( Nucleus (leaf 17) (rel2par span) (text _!Our government reimburses the CEOs of private contractors at a rate approximately double what we pay the President ._!) )
            ( Satellite (leaf 18) (rel2par elaboration-additional) (text _!Overall , we pay the corporate bosses over $ 7 billion a year ._!) )
          )
        )
        ( Satellite (span 19 20) (rel2par causal-result)
          ( Satellite (leaf 19) (rel2par attribution-negative) (text _!Many Americans do n't realize_!) )
          ( Nucleus (leaf 20) (rel2par span) (text _!that the privatization of Social Security and Medicare would transfer much of our money to yet another group of CEOs ._!) )
        )
      )
    )
  )
  ( Nucleus (span 21 93) (rel2par joint-list)
    ( Nucleus (span 21 48) (rel2par joint-list)
      ( Nucleus (span 21 22) (rel2par span)
        ( Nucleus (leaf 21) (rel2par adversative-contrast) (text _!2. Privatization Serves People with Money ,_!) )
        ( Nucleus (leaf 22) (rel2par adversative-contrast) (text _!the Public Sector Serves Everyone_!) )
      )
      ( Satellite (span 23 48) (rel2par explanation-evidence)
        ( Nucleus (span 23 37) (rel2par joint-list)
          ( Nucleus (span 23 25) (rel2par span)
            ( Nucleus (span 23 24) (rel2par span)
              ( Nucleus (leaf 23) (rel2par span) (text _!A good example is the U.S. Postal Service_!) )
              ( Satellite (leaf 24) (rel2par restatement-partial) (text _!( USPS ) ,_!) )
            )
            ( Satellite (leaf 25) (rel2par elaboration-attribute) (text _!which is legally required to serve every home in the country ._!) )
          )
          ( Satellite (span 26 37) (rel2par elaboration-additional)
            ( Nucleus (span 26 28) (rel2par adversative-contrast)
              ( Nucleus (span 26 27) (rel2par same-unit)
                ( Nucleus (leaf 26) (rel2par span) (text _!Fedex and United Parcel Service_!) )
                ( Satellite (leaf 27) (rel2par restatement-partial) (text _!( UPS )_!) )
              )
              ( Nucleus (leaf 28) (rel2par same-unit) (text _!ca n't serve unprofitable locations ._!) )
            )
            ( Nucleus (span 29 37) (rel2par adversative-contrast)
              ( Nucleus (span 29 35) (rel2par span)
                ( Nucleus (leaf 29) (rel2par span) (text _!Yet the USPS is much cheaper for small packages ._!) )
                ( Satellite (span 30 35) (rel2par explanation-evidence)
                  ( Satellite (leaf 30) (rel2par attribution-positive) (text _!An online comparison revealed the following for the two - day shipment of a similarly - sized envelope to another state :_!) )
                  ( Nucleus (span 31 35) (rel2par span)
                    ( Nucleus (span 31 33) (rel2par adversative-contrast)
                      ( Nucleus (leaf 31) (rel2par span) (text _!– USPS 2 - Day $ 5.68_!) )
                      ( Satellite (span 32 33) (rel2par elaboration-additional)
                        ( Nucleus (leaf 32) (rel2par span) (text _!( 46 cents_!) )
                        ( Satellite (leaf 33) (rel2par mode-manner) (text _!without the 2 - day restriction )_!) )
                      )
                    )
                    ( Nucleus (span 34 35) (rel2par adversative-contrast)
                      ( Nucleus (leaf 34) (rel2par adversative-contrast) (text _!– FedEx 2 - Day $ 19.28_!) )
                      ( Nucleus (leaf 35) (rel2par adversative-contrast) (text _!– UPS , 2 Day $ 24.09_!) )
                    )
                  )
                )
              )
              ( Satellite (span 36 37) (rel2par elaboration-additional)
                ( Satellite (leaf 36) (rel2par causal-cause) (text _!USPS is so inexpensive , in fact ,_!) )
                ( Nucleus (leaf 37) (rel2par span) (text _!that Fedex actually uses the U.S. Post Office for about 30 percent of its ground shipments ._!) )
              )
            )
          )
        )
        ( Nucleus (span 38 48) (rel2par joint-list)
          ( Nucleus (span 38 44) (rel2par joint-list)
            ( Nucleus (leaf 38) (rel2par span) (text _!Another example is education ._!) )
            ( Satellite (span 39 44) (rel2par explanation-evidence)
              ( Nucleus (span 39 40) (rel2par joint-list)
                ( Satellite (leaf 39) (rel2par attribution-positive) (text _!A recent ProPublica report found_!) )
                ( Nucleus (leaf 40) (rel2par span) (text _!that in the past twenty years four - year state colleges have been serving a diminishing portion of the country 's lowest - income students ._!) )
              )
              ( Nucleus (span 41 44) (rel2par joint-list)
                ( Nucleus (leaf 41) (rel2par span) (text _!At the K - 12 level , cost - saving business strategies apply to the privatization of our children 's education ._!) )
                ( Satellite (span 42 44) (rel2par explanation-evidence)
                  ( Nucleus (leaf 42) (rel2par joint-list) (text _!Charter schools are less likely to accept students with disabilities ._!) )
                  ( Nucleus (span 43 44) (rel2par joint-list)
                    ( Nucleus (leaf 43) (rel2par joint-list) (text _!Charter teachers have fewer years of experience and a higher turnover rate ._!) )
                    ( Nucleus (leaf 44) (rel2par joint-list) (text _!Non-teacher positions have insufficient retirement plans and health insurance , and much lower pay ._!) )
                  )
                )
              )
            )
          )
          ( Nucleus (span 45 48) (rel2par joint-list)
            ( Nucleus (span 45 46) (rel2par joint-list)
              ( Nucleus (leaf 45) (rel2par span) (text _!Finally , with regard to health care , 43 percent of sick Americans skipped doctor 's visits and / or medication purchases in 2011_!) )
              ( Satellite (leaf 46) (rel2par causal-cause) (text _!because of excessive costs ._!) )
            )
            ( Nucleus (span 47 48) (rel2par joint-list)
              ( Nucleus (leaf 47) (rel2par span) (text _!It 's estimated that over 40,000 Americans die every year_!) )
              ( Satellite (leaf 48) (rel2par causal-cause) (text _!because they ca n't afford health insurance ._!) )
            )
          )
        )
      )
    )
    ( Nucleus (span 49 93) (rel2par joint-list)
      ( Nucleus (span 49 76) (rel2par joint-list)
        ( Nucleus (leaf 49) (rel2par span) (text _!3. Privatization Turns Essential Human Needs into Products_!) )
        ( Satellite (span 50 76) (rel2par explanation-evidence)
          ( Nucleus (span 50 53) (rel2par joint-list)
            ( Nucleus (leaf 50) (rel2par span) (text _!Big business would like to privatize our water ._!) )
            ( Satellite (span 51 53) (rel2par explanation-evidence)
              ( Satellite (leaf 51) (rel2par attribution-positive) (text _!A Citigroup economist exulted ,_!) )
              ( Nucleus (span 52 53) (rel2par span)
                ( Nucleus (leaf 52) (rel2par span) (text _!" Water as an asset class will , in my view , become eventually the single most important physical - commodity based asset class ,_!) )
                ( Satellite (leaf 53) (rel2par elaboration-additional) (text _!dwarfing oil , copper , agricultural commodities and precious metals . "_!) )
              )
            )
          )
          ( Nucleus (span 54 76) (rel2par joint-list)
            ( Nucleus (span 54 59) (rel2par joint-list)
              ( Nucleus (leaf 54) (rel2par span) (text _!They want our federal land ._!) )
              ( Satellite (span 55 59) (rel2par explanation-evidence)
                ( Nucleus (leaf 55) (rel2par joint-sequence) (text _!Attempts at privatization were made by the Reagan administration in the 1980s and the Republican - controlled Congress in the 1990s ._!) )
                ( Nucleus (span 56 59) (rel2par joint-sequence)
                  ( Nucleus (span 56 57) (rel2par joint-sequence)
                    ( Satellite (leaf 56) (rel2par attribution-positive) (text _!In 2006 , President Bush proposed_!) )
                    ( Nucleus (leaf 57) (rel2par span) (text _!auctioning off 300,000 acres of national forest in 41 states ._!) )
                  )
                  ( Nucleus (span 58 59) (rel2par joint-sequence)
                    ( Nucleus (leaf 58) (rel2par span) (text _!Paul Ryan 's Path to Prosperity was based in part on Republican Jason Chaffetz ' " Disposal of Excess Federal Lands Act of 2011 , "_!) )
                    ( Satellite (leaf 59) (rel2par elaboration-attribute) (text _!which would unload millions of acres of land in America 's west ._!) )
                  )
                )
              )
            )
            ( Nucleus (span 60 76) (rel2par joint-list)
              ( Nucleus (span 60 69) (rel2par joint-list)
                ( Nucleus (leaf 60) (rel2par span) (text _!They want our cities ._!) )
                ( Satellite (span 61 69) (rel2par explanation-evidence)
                  ( Satellite (span 61 62) (rel2par context-background)
                    ( Satellite (leaf 61) (rel2par attribution-positive) (text _!A privatization expert told the Detroit Free Press_!) )
                    ( Nucleus (leaf 62) (rel2par span) (text _!that the real money is in urban assets with a " revenue stream . "_!) )
                  )
                  ( Nucleus (span 63 69) (rel2par span)
                    ( Nucleus (span 63 67) (rel2par span)
                      ( Nucleus (span 63 64) (rel2par same-unit)
                        ( Nucleus (leaf 63) (rel2par span) (text _!So Detroit 's most valuable resource , its Water & Sewerage Department_!) )
                        ( Satellite (leaf 64) (rel2par restatement-partial) (text _!( DWSD ) ,_!) )
                      )
                      ( Nucleus (span 65 67) (rel2par same-unit)
                        ( Nucleus (leaf 65) (rel2par span) (text _!is the collateral for a loan of $ 350 million_!) )
                        ( Satellite (span 66 67) (rel2par purpose-attribute)
                          ( Nucleus (leaf 66) (rel2par span) (text _!to pay off the banks_!) )
                          ( Satellite (leaf 67) (rel2par elaboration-attribute) (text _!handling the litigation ._!) )
                        )
                      )
                    )
                    ( Satellite (span 68 69) (rel2par causal-result)
                      ( Nucleus (leaf 68) (rel2par span) (text _!Bloomberg estimates a cost of almost half a billion dollars , in a city_!) )
                      ( Satellite (leaf 69) (rel2par elaboration-attribute) (text _!where homeowners can barely afford the water services ._!) )
                    )
                  )
                )
              )
              ( Nucleus (span 70 76) (rel2par joint-list)
                ( Nucleus (leaf 70) (rel2par span) (text _!And they want our bodies ._!) )
                ( Satellite (span 71 76) (rel2par explanation-evidence)
                  ( Nucleus (leaf 71) (rel2par joint-list) (text _!One - fifth of the human genome is privately owned through patents ._!) )
                  ( Nucleus (span 72 76) (rel2par joint-list)
                    ( Satellite (leaf 72) (rel2par causal-cause) (text _!Strains of influenza and hepatitis have been claimed by corporate and university labs ,_!) )
                    ( Nucleus (span 73 76) (rel2par span)
                      ( Nucleus (span 73 75) (rel2par span)
                        ( Nucleus (leaf 73) (rel2par same-unit) (text _!and_!) )
                        ( Nucleus (span 74 75) (rel2par same-unit)
                          ( Satellite (leaf 74) (rel2par causal-cause) (text _!because of this_!) )
                          ( Nucleus (leaf 75) (rel2par span) (text _!researchers ca n't use the patented life forms_!) )
                        )
                      )
                      ( Satellite (leaf 76) (rel2par purpose-goal) (text _!to perform cancer research ._!) )
                    )
                  )
                )
              )
            )
          )
        )
      )
      ( Nucleus (span 77 93) (rel2par joint-list)
        ( Nucleus (leaf 77) (rel2par span) (text _!4. Public Systems Promote a Strong Middle Class_!) )
        ( Satellite (span 78 93) (rel2par explanation-evidence)
          ( Satellite (span 78 80) (rel2par adversative-concession)
            ( Nucleus (leaf 78) (rel2par span) (text _!Part of free - market mythology is that public employees and union workers are greedy takers ,_!) )
            ( Satellite (span 79 80) (rel2par elaboration-attribute)
              ( Nucleus (leaf 79) (rel2par span) (text _!enjoying benefits_!) )
              ( Satellite (leaf 80) (rel2par elaboration-attribute) (text _!that average private sector workers are denied ._!) )
            )
          )
          ( Nucleus (span 81 93) (rel2par span)
            ( Nucleus (span 81 82) (rel2par span)
              ( Satellite (leaf 81) (rel2par attribution-positive) (text _!But the facts show_!) )
              ( Nucleus (leaf 82) (rel2par span) (text _!that government and union workers are not overpaid ._!) )
            )
            ( Satellite (span 83 93) (rel2par explanation-evidence)
              ( Nucleus (span 83 85) (rel2par joint-list)
                ( Satellite (leaf 83) (rel2par attribution-positive) (text _!According to the Census Bureau ,_!) )
                ( Nucleus (span 84 85) (rel2par span)
                  ( Nucleus (leaf 84) (rel2par joint-list) (text _!state and local government employees make up 14.5 % of the U.S. workforce_!) )
                  ( Nucleus (leaf 85) (rel2par joint-list) (text _!and receive 14.3 % of the total compensation ._!) )
                )
              )
              ( Nucleus (span 86 93) (rel2par joint-list)
                ( Nucleus (span 86 88) (rel2par joint-list)
                  ( Nucleus (leaf 86) (rel2par adversative-contrast) (text _!Union members make up about 12 % of the workforce ,_!) )
                  ( Nucleus (span 87 88) (rel2par adversative-contrast)
                    ( Nucleus (leaf 87) (rel2par span) (text _!but their total pay amounts to just 10 % of adjusted gross income_!) )
                    ( Satellite (leaf 88) (rel2par explanation-evidence) (text _!as reported to the IRS ._!) )
                  )
                )
                ( Nucleus (span 89 93) (rel2par joint-list)
                  ( Nucleus (span 89 92) (rel2par span)
                    ( Satellite (leaf 89) (rel2par adversative-concession) (text _!The average private sector worker makes about the same salary as a state or local government worker ._!) )
                    ( Nucleus (span 90 92) (rel2par span)
                      ( Nucleus (span 90 91) (rel2par same-unit)
                        ( Nucleus (leaf 90) (rel2par span) (text _!But the median salary for U.S. workers ,_!) )
                        ( Satellite (leaf 91) (rel2par elaboration-attribute) (text _!83 % of whom are in the private sector ,_!) )
                      )
                      ( Nucleus (leaf 92) (rel2par same-unit) (text _!was $ 18,000 less in 2009 , at $ 26,261 ._!) )
                    )
                  )
                  ( Satellite (leaf 93) (rel2par evaluation-comment) (text _!Inequality is much more pervasive in the private sector ._!) )
                )
              )
            )
          )
        )
      )
    )
  )
)
