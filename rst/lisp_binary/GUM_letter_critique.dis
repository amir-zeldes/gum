            ( Satellite (span 59 69) (rel2par explanation-justify)
              ( Nucleus (span 59 64) (rel2par span)
                ( Nucleus (leaf 59) (rel2par span) (text _!I regret sincerely to see such a lack of Patriotism in the Present Administration and in the representatives of the North ._!) )
                ( Satellite (span 60 64) (rel2par explanation-justify)
