		<segment id="44" parent="289" relname="span">Cause I got ta clean up in here ,</segment>
		<segment id="45" parent="290" relname="span">this place is just totally trashed ,</segment>
		<segment id="46" parent="291" relname="span">cause I 've done nothing this week</segment>
		<segment id="47" parent="292" relname="joint-list">but study</segment>
		<segment id="48" parent="293" relname="span">and be sick .</segment>
