		<segment id="56" parent="301" relname="span">Please ,</segment>
		<segment id="57" parent="58" relname="attribution-positive">I know</segment>
		<segment id="58" parent="302" relname="span">it 's tempting .</segment>
		<segment id="59" parent="300" relname="span">What I 'd like you to do is put those cans away please .</segment>
		<segment id="60" parent="303" relname="restatement-repetition">Where — where — oh there they are .</segment>
		<segment id="61" parent="303" relname="restatement-repetition">Yeah , there they are .</segment>
