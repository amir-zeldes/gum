		<segment id="6" parent="250" relname="span">Look at my shoes .</segment>
		<segment id="7" parent="251" relname="span">They look like the phantom stair - steppers .</segment>
		<segment id="8" parent="7" relname="organization-phatic">Hunh .</segment>
		<segment id="9" parent="253" relname="span">No - no , it looks like the Invisible Man .</segment>
