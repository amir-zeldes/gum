		<segment id="33" parent="32" relname="elaboration-attribute">that are in your bedroom ,</segment>
		<segment id="34" parent="286" relname="restatement-repetition">and then we can do can squish .</segment>
		<segment id="35" parent="286" relname="restatement-repetition">And squish em .</segment>
		<segment id="36" parent="286" relname="purpose-goal">For the recycling bin .</segment>
		<segment id="37" parent="273" relname="organization-phatic">Okay ?</segment>
		<segment id="38" parent="288" relname="span">Tomorrow please ,</segment>
		<segment id="39" parent="38" relname="explanation-motivation">my feet are hurting .</segment>
		<segment id="40" parent="288" relname="restatement-partial">Tomorrow ?</segment>
		<segment id="41" parent="476" relname="span">Well can you just put em in the bag , in there for now ,</segment>
		<segment id="42" parent="41" relname="organization-phatic">okay ?</segment>
