	<body>
		<segment id="1" parent="317" relname="span">Well , this is the agenda .</segment>
		<segment id="2" parent="1" relname="organization-phatic">And I am --</segment>
		<segment id="3" parent="172" relname="restatement-repetition">Actually , oh , no , do n't ,</segment>
		<segment id="4" parent="172" relname="restatement-repetition">let 's not .</segment>
		<segment id="5" parent="176" relname="adversative-contrast">Yes .</segment>
		<segment id="6" parent="173" relname="span">No ,</segment>
		<segment id="7" parent="171" relname="adversative-antithesis">because they released his salary</segment>
		<segment id="8" parent="171" relname="span">and I do n't want my salary released</segment>
		<segment id="9" parent="177" relname="span">because it 'll be so embarrassing .</segment>
		<segment id="10" parent="178" relname="span">Embarrassing you , man .</segment>
		<segment id="11" parent="179" relname="span">Mine is right now .</segment>
		<segment id="12" parent="180" relname="span">You do n't want to know .</segment>
		<segment id="13" parent="12" relname="organization-phatic">Okay .</segment>
		<segment id="14" parent="195" relname="span">Conditioning has changed tremendously .</segment>
		<segment id="15" parent="183" relname="organization-phatic">I mean ,</segment>
		<segment id="16" parent="182" relname="span">one of the things</segment>
		<segment id="17" parent="16" relname="elaboration-attribute">some of us , not everybody , fighting</segment>
		<segment id="18" parent="184" relname="span">is the mega developments and the monster homes</segment>
		<segment id="19" parent="18" relname="elaboration-attribute">going up in lakes .</segment>
		<segment id="20" parent="186" relname="adversative-concession">And and so these people are coming out to the , quote , cottage or in central Canada or eastern Canada , that cabin or in Quebec , the shed .</segment>
		<segment id="21" parent="186" relname="span">But their vision of what a cottage is or a cabin is totally different from what we were brought up as those</segment>
		<segment id="22" parent="21" relname="elaboration-attribute">who grew up in the environment .</segment>
		<segment id="23" parent="188" relname="span">We may all be boomers .</segment>
		<segment id="24" parent="23" relname="elaboration-additional">Baby boomers and turn of age group .</segment>
		<segment id="25" parent="187" relname="adversative-contrast">We may not be ,</segment>
		<segment id="26" parent="187" relname="adversative-contrast">but we may be .</segment>
		<segment id="27" parent="190" relname="span">But it 's our life experiences that are different ,</segment>
		<segment id="28" parent="27" relname="organization-phatic">you know .</segment>
		<segment id="29" parent="196" relname="span">1.7 million dollars does n't buy you a whole lot up in the Muskokas anymore .</segment>
		<segment id="30" parent="29" relname="restatement-partial">It does n't .</segment>
		<segment id="31" parent="197" relname="joint-sequence">And most cottages were built by the individuals</segment>
		<segment id="32" parent="198" relname="span">and passed on to the next generation .</segment>
		<segment id="33" parent="32" relname="elaboration-additional">The whole tax structure has changed and the --</segment>
		<segment id="34" parent="200" relname="joint-sequence">Third generation buys a lot .</segment>
		<segment id="35" parent="200" relname="joint-sequence">Next door bulldozes it ,</segment>
		<segment id="36" parent="200" relname="joint-sequence">annexes them both together</segment>
		<segment id="37" parent="200" relname="joint-sequence">and builds the 2 million dollar resort .</segment>
		<segment id="38" parent="39" relname="organization-preparation">No , you 're wrong .</segment>
		<segment id="39" parent="202" relname="span">It 's not the next generation .</segment>
		<segment id="40" parent="203" relname="span">In most cases , it 's people from the cities with a lot of money</segment>
		<segment id="41" parent="40" relname="elaboration-attribute">who have never had a cottage .</segment>
		<segment id="42" parent="203" relname="causal-result">They do n't know what cottaging is .</segment>
		<segment id="43" parent="44" relname="organization-phatic">It 's --</segment>
		<segment id="44" parent="206" relname="span">to them what they 're building is an all inclusive resort , a private , all inclusive resort on a lake .</segment>
		<segment id="45" parent="207" relname="span">And they expect it to either be one totally landscaped like their suburban home ,</segment>
		<segment id="46" parent="45" relname="causal-result">and so they 'll move in .</segment>
		<segment id="47" parent="210" relname="span">They love this area</segment>
		<segment id="48" parent="47" relname="causal-cause">because it 's trees and wilderness ,</segment>
		<segment id="49" parent="211" relname="span">and the first thing</segment>
		<segment id="50" parent="49" relname="elaboration-attribute">they do</segment>
		<segment id="51" parent="212" relname="same-unit">is cut down the trees ,</segment>
		<segment id="52" parent="213" relname="joint-sequence">bring in landfill plant sod</segment>
		<segment id="53" parent="213" relname="joint-sequence">and make it look just like a city suburb .</segment>
		<segment id="54" parent="215" relname="evaluation-comment">And that is what the true cottagers , the historical cottagers , absolutely resent .</segment>
		<segment id="55" parent="234" relname="same-unit">And ,</segment>
		<segment id="56" parent="222" relname="organization-phatic">you know ,</segment>
		<segment id="57" parent="220" relname="span">there 's major battles</segment>
		<segment id="58" parent="219" relname="span">going on in cottage country now</segment>
		<segment id="59" parent="58" relname="causal-cause">because of that</segment>
		<segment id="60" parent="223" relname="span">with those with the new money</segment>
		<segment id="61" parent="62" relname="adversative-concession">who are n't cottagers</segment>
		<segment id="62" parent="221" relname="span">but are building these major , major things</segment>
		<segment id="63" parent="224" relname="span">and the old family multigenerational cottages , people</segment>
		<segment id="64" parent="63" relname="elaboration-attribute">who grow up in cottage country</segment>
		<segment id="65" parent="226" relname="joint-list">who really love the wilderness</segment>
		<segment id="66" parent="67" relname="organization-phatic">and want yeah ,</segment>
		<segment id="67" parent="227" relname="span">they want modernization ,</segment>
		<segment id="68" parent="228" relname="span">but they want it on a small scale</segment>
		<segment id="69" parent="229" relname="adversative-concession">and they want comfort ,</segment>
		<segment id="70" parent="229" relname="span">but they do n't want it at the expense</segment>
		<segment id="71" parent="230" relname="joint-list">of blasting rocks ,</segment>
		<segment id="72" parent="230" relname="joint-list">ripping down trees</segment>
		<segment id="73" parent="230" relname="joint-list">and destroying shorelines</segment>
		<segment id="74" parent="231" relname="span">and having boat houses across the shorelines every 100 feet</segment>
		<segment id="75" parent="74" relname="elaboration-attribute">that make it look like somebody 's back lane .</segment>
		<segment id="76" parent="237" relname="topic-solutionhood">Oh , am I on a soapbox here ?</segment>
		<segment id="77" parent="78" relname="attribution-positive">Can I suggest</segment>
		<segment id="78" parent="235" relname="span">that you get off your th- ,</segment>
		<segment id="79" parent="80" relname="attribution-positive">can I suggest</segment>
		<segment id="80" parent="236" relname="span">you get off your soapbox for a second ?</segment>
		<segment id="81" parent="238" relname="span">Yeah , absolutely .</segment>
		<segment id="82" parent="246" relname="span">This is</segment>
		<segment id="83" parent="82" relname="causal-cause">because it 's</segment>
		<segment id="84" parent="245" relname="same-unit">cottaging in Muskoka is</segment>
		<segment id="85" parent="243" relname="organization-phatic">I mean ,</segment>
		<segment id="86" parent="242" relname="span">a lot of people think about a cottage in Muskoka as a place</segment>
		<segment id="87" parent="86" relname="purpose-attribute">to go</segment>
		<segment id="88" parent="240" relname="span">and a place</segment>
		<segment id="89" parent="241" relname="joint-list">to get away from the city ,</segment>
		<segment id="90" parent="241" relname="joint-list">to relax on a lake and everything .</segment>
		<segment id="91" parent="248" relname="span">But it it really does have a history to it .</segment>
		<segment id="92" parent="250" relname="joint-list">And it goes back a long , long , long way .</segment>
		<segment id="93" parent="94" relname="organization-preparation">And it 's not what a lot of people think about cottaging .</segment>
		<segment id="94" parent="249" relname="span">It 's not the 2 million dollar place on the shoreline .</segment>
		<segment id="95" parent="251" relname="organization-preparation">People .</segment>
		<segment id="96" parent="251" relname="span">People come up here</segment>
		<segment id="97" parent="96" relname="causal-cause">because they like to be on the lake</segment>
		<segment id="98" parent="253" relname="joint-list">and you sit on the dock</segment>
		<segment id="99" parent="253" relname="joint-list">and you look around the lake</segment>
		<segment id="100" parent="253" relname="joint-list">and you see the natural lake .</segment>
		<segment id="101" parent="258" relname="same-unit">And</segment>
		<segment id="102" parent="254" relname="joint-sequence">if people come up in the city</segment>
		<segment id="103" parent="254" relname="joint-sequence">and they take down all that shoreline</segment>
		<segment id="104" parent="254" relname="joint-sequence">and build their million dollar cottages on the shoreline ,</segment>
		<segment id="105" parent="255" relname="joint-list">you wind up sitting on your dock</segment>
		<segment id="106" parent="255" relname="joint-list">looking around the lake ,</segment>
		<segment id="107" parent="256" relname="span">seeing nothing but million dollar cottages</segment>
		<segment id="108" parent="107" relname="elaboration-attribute">lined up along the shoreline .</segment>
		<segment id="109" parent="258" relname="causal-result">And it starts looking like the suburbs .</segment>
		<segment id="110" parent="259" relname="organization-phatic">Exactly .</segment>
		<segment id="111" parent="260" relname="evaluation-comment">And that , that was my point .</segment>
		<segment id="112" parent="262" relname="span">And and the debate</segment>
		<segment id="113" parent="112" relname="elaboration-attribute">you get into</segment>
		<segment id="114" parent="263" relname="same-unit">is , well , it 's my property .</segment>
		<segment id="115" parent="267" relname="span">I can do whatever I want on it .</segment>
		<segment id="116" parent="265" relname="span">And I got ,</segment>
		<segment id="117" parent="116" relname="organization-phatic">you know ,</segment>
		<segment id="118" parent="266" relname="span">and this is what I want to do .</segment>
		<segment id="119" parent="269" relname="span">And so it 's difficult</segment>
		<segment id="120" parent="268" relname="span">because , yeah , you do n't want to deny people their rights</segment>
		<segment id="121" parent="120" relname="purpose-attribute">to do things .</segment>
		<segment id="122" parent="271" relname="span">But the irony is these these newcomers ,</segment>
		<segment id="123" parent="122" relname="adversative-concession">if you will ,</segment>
		<segment id="124" parent="272" relname="same-unit">move up to this area</segment>
		<segment id="125" parent="272" relname="causal-cause">because of what it has to offer</segment>
		<segment id="126" parent="274" relname="span">and then they effectively destroy it</segment>
		<segment id="127" parent="126" relname="purpose-goal">in order to recreate .</segment>
		<segment id="128" parent="279" relname="same-unit">So</segment>
		<segment id="129" parent="276" relname="span">instead of building buildings</segment>
		<segment id="130" parent="129" relname="elaboration-attribute">that fit the landscape ,</segment>
		<segment id="131" parent="277" relname="span">they change the landscape</segment>
		<segment id="132" parent="131" relname="purpose-goal">to fit their ideal vision of a building .</segment>
		<segment id="133" parent="315" relname="organization-preparation">And I 'll give you a personal experience with this .</segment>
		<segment id="134" parent="280" relname="span">When I built the place</segment>
		<segment id="135" parent="134" relname="elaboration-attribute">I built here ,</segment>
		<segment id="136" parent="282" relname="same-unit">I wanted to be ,</segment>
		<segment id="137" parent="138" relname="organization-phatic">you know ,</segment>
		<segment id="138" parent="281" relname="span">close to the water .</segment>
		<segment id="139" parent="284" relname="organization-phatic">Just I mean ,</segment>
		<segment id="140" parent="284" relname="span">that 's one of the key reasons</segment>
		<segment id="141" parent="140" relname="elaboration-attribute">you 're up here .</segment>
		<segment id="142" parent="289" relname="span">And man , you could n't be closer than 66 feet .</segment>
		<segment id="143" parent="144" relname="explanation-evidence">So I measured out</segment>
		<segment id="144" parent="288" relname="span">and my corner , my lot , the my building was just almost dead on 66 feet .</segment>
		<segment id="145" parent="146" relname="causal-cause">And it -- because of the slant of the building and the shape of the shoreline ,</segment>
		<segment id="146" parent="290" relname="span">it moved away from that .</segment>
		<segment id="147" parent="291" relname="elaboration-additional">That was the closest point .</segment>
		<segment id="148" parent="149" relname="context-circumstance">People continually come in</segment>
		<segment id="149" parent="293" relname="span">wanting to build ten , 13 , 15 feet from the shoreline .</segment>
		<segment id="150" parent="294" relname="joint-list">Now zero feet .</segment>
		<segment id="151" parent="152" relname="organization-phatic">Oh , I mean ,</segment>
		<segment id="152" parent="295" relname="span">it 's incredible .</segment>
		<segment id="153" parent="299" relname="same-unit">But</segment>
		<segment id="154" parent="297" relname="span">when I was building</segment>
		<segment id="155" parent="154" relname="adversative-concession">and I have cottage going back in my blood three generations</segment>
		<segment id="156" parent="298" relname="span">I too even then , I did n't quite understand it .</segment>
		<segment id="157" parent="302" relname="same-unit">And</segment>
		<segment id="158" parent="159" relname="context-circumstance">when I built my place ,</segment>
		<segment id="159" parent="300" relname="span">now I go ,</segment>
		<segment id="160" parent="301" relname="span">" oh my goodness , thank goodness</segment>
		<segment id="161" parent="160" relname="causal-cause">I did n't build any closer . "</segment>
		<segment id="162" parent="163" relname="explanation-justify">I am too close to the water .</segment>
		<segment id="163" parent="305" relname="span">I should have built further back .</segment>
		<segment id="164" parent="307" relname="joint-list">But we are conditioned from the city to be right on the street</segment>
		<segment id="165" parent="307" relname="joint-list">and the water is our street</segment>
		<segment id="166" parent="308" relname="span">and people</segment>
		<segment id="167" parent="166" relname="elaboration-attribute">coming in ,</segment>
		<segment id="168" parent="309" relname="same-unit">they they do n't get it .</segment>
		<segment id="169" parent="310" relname="span">And I can relate</segment>
		<segment id="170" parent="169" relname="causal-cause">because I did n't get it , even with my experience .</segment>
		<group id="171" type="span" parent="174" relname="span"/>
